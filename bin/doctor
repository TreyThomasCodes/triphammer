#!/usr/bin/env bash
# Lists what is missing or wrong on the machine for one project, one line per problem with its fix, and exits 1
# when anything is, or prints `all good` and exits 0. `ticket-runner --doctor` runs it; see bin/README.md
# ("Doctor"). It changes nothing: no self-update, no claims, no sessions. Its one write is `git fetch origin` in the
# checkout, so the checkout is compared with the current origin/main.
#
# It reads the project's Triphammer config (config.sh; a malformed or missing config stops it with exit 2 and the
# config's own message), looks every command up on the units' PATH rather than the caller's, and runs the checks the
# README's Doctor table lists. Credential files are checked with stat only; nothing here opens, reads or prints them.
# No command's output is passed on except version numbers, so no token, key or account name reaches the output.
#
#   doctor [--before-start]
#
# --before-start, which `triphammer add` gives, leaves out the check that the project's units are enabled, since only
# `triphammer start` enables them, and says so in a line of its own. Any other argument exits 2.
set -euo pipefail

before_start=""
case "$*" in
  '') ;;
  --before-start) before_start=1 ;;
  *) echo "usage: ticket-runner --doctor [--before-start]" >&2; exit 2 ;;
esac

bin="$(dirname "$(readlink -f "$0")")"
# shellcheck source=bin/config.sh
source "$bin/config.sh"
# shellcheck source=bin/labels.sh
source "$bin/labels.sh"
load_config "ticket-runner --doctor" "$bin/.."
checkout="$cfg_checkout" project="$cfg_project"

problems=0
# problem <what is wrong> <the fix>: prints one line.
problem() {
  printf '%s. Fix: %s\n' "$1" "$2"
  problems=$((problems + 1))
}
# version_at_least <a> <b>: succeeds when version a is b or later.
version_at_least() {
  [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n 1)" = "$2" ]
}
# first_version <text>: prints the first dotted version number in the text, or nothing.
first_version() {
  grep -oE '[0-9]+(\.[0-9]+)+' <<< "$1" | head -n 1 || true
}
# tool <command> <what it is> <how to install it>: succeeds when the command runs `--version`; otherwise reports it.
tool() {
  if ! command -v "$1" >/dev/null 2>&1 || ! "$1" --version >/dev/null 2>&1; then
    problem "$2 ($1) is not installed or does not run on the units' PATH" "$3"
    return 1
  fi
}

# One project: a machine serves one project, so a second config in ${XDG_CONFIG_HOME:-~/.config}/triphammer is a
# problem.
configs=()
for config_file in "${XDG_CONFIG_HOME:-$HOME/.config}"/triphammer/*.conf; do
  [ -f "$config_file" ] || continue
  config_file="${config_file##*/}" configs+=("${config_file%.conf}")
done
if [ ${#configs[@]} -gt 1 ]; then
  problem "this machine has the configs of several projects (${configs[*]}), but a machine serves one project" \
    "move all but one of them to machines of their own, each set up with triphammer add (bin/README.md, Several projects)"
fi

# The units' PATH: Triphammer's units find their tools there, so a tool only on the caller's PATH (nvm's node, say) is
# missing to them. ticket-runner@'s is taken, as the sessions run under it; merge-when-ready@ and demo-gallery@ build
# and test nothing. The unit file is Triphammer's, so it is read from Triphammer's checkout (this script's), not the
# project's. Without it the checks run on the caller's PATH, and that is a problem of its own. A drop-in of the user's
# (ticket-runner@.service.d/*.conf for every project, ticket-runner@<project>.service.d/*.conf for this one) that sets
# PATH replaces the unit's, as systemd reads them after the unit, in the order of their file names, the instance's
# file before the template's of the same name.
path_of() { sed -n 's/^Environment="\{0,1\}PATH=\([^"]*\)"\{0,1\}$/\1/p' "$@" 2>/dev/null | tail -n 1 || true; }
triphammer="$(cd "$bin/.." && pwd)"
unit_file="$triphammer/systemd/ticket-runner@.service"
unit_path="$(path_of "$unit_file")"
if [ -n "$unit_path" ]; then
  user_units="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  while IFS= read -r name; do
    drop_in="$user_units/ticket-runner@$project.service.d/$name"
    [ -f "$drop_in" ] || drop_in="$user_units/ticket-runner@.service.d/$name"
    drop_in_path="$(path_of "$drop_in")"
    [ -z "$drop_in_path" ] || unit_path="$drop_in_path"
  done < <(find "$user_units/ticket-runner@.service.d" "$user_units/ticket-runner@$project.service.d" -maxdepth 1 \
    -name '*.conf' -printf '%f\n' 2>/dev/null | LC_ALL=C sort -u)
  PATH="${unit_path//%h/$HOME}"
else
  problem "$unit_file is missing, unreadable or sets no PATH, so the tools were looked up on the caller's PATH" \
    "restore it from origin/main in Triphammer's checkout (git -C $triphammer checkout origin/main -- systemd/ticket-runner@.service)"
fi
units_path="where the units' PATH finds it"

# jq first: the .NET SDK, Node engines, Claude Code login and plugin checks read JSON with it and are skipped without
# it, so a missing jq is reported once rather than as their false problems.
jq_ok=""
if tool jq jq "install jq $units_path; the .NET SDK, Node engines, Claude Code login and plugin checks are skipped until it runs"; then jq_ok=1; fi

# The .NET SDK: one SDK the checkout's global.json accepts. rollForward disable takes the pinned version only; patch
# and latestPatch (and no rollForward) the same feature band (the hundreds of the patch number) at or after it;
# feature and latestFeature the same major.minor; minor and latestMinor the same major; major and latestMajor any later
# version. A prerelease SDK counts only with allowPrerelease true. Without a global.json there is no pin to check.
if [ -n "$jq_ok" ] && [ -f "$checkout/global.json" ]; then
  pin="$(jq -r '.sdk.version // empty' "$checkout/global.json" 2>/dev/null || true)"
  roll="$(jq -r '.sdk.rollForward // "latestPatch"' "$checkout/global.json" 2>/dev/null || true)"
  prerelease="$(jq -r '.sdk.allowPrerelease // false' "$checkout/global.json" 2>/dev/null || true)"
  # The version shapes provision-project installs: major.minor.patch with an optional prerelease suffix.
  sdk_version='^([0-9]+)\.([0-9]+)\.([0-9]+)(-[A-Za-z0-9.]+)?$'
  if [[ "$pin" =~ $sdk_version ]]; then
    pin_minor="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}" pin_band="$((10#${BASH_REMATCH[3]} / 100))"
    pin_release="${pin%%-*}" pin_suffix="${BASH_REMATCH[4]}"
    found=""
    if sdks="$(dotnet --list-sdks 2>/dev/null)"; then
      while read -r sdk _; do
        [[ "$sdk" =~ $sdk_version ]] || continue
        [ -z "${BASH_REMATCH[4]}" ] || [ "$prerelease" = true ] || continue
        case "$roll" in
          disable) same="$sdk" want="$pin" ;;
          patch|latestPatch) same="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}.$((10#${BASH_REMATCH[3]} / 100))" want="$pin_minor.$pin_band" ;;
          feature|latestFeature) same="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}" want="$pin_minor" ;;
          minor|latestMinor) same="${BASH_REMATCH[1]}" want="${pin_minor%%.*}" ;;
          *) same="" want="" ;;
        esac
        [ "$same" = "$want" ] || continue
        # At or after the pin: a later release, or the same release with no suffix (a release follows its
        # prereleases) or a suffix at or after the pin's.
        sdk_release="${sdk%%-*}" sdk_suffix="${BASH_REMATCH[4]}"
        if [ "$sdk_release" != "$pin_release" ]; then
          version_at_least "$sdk_release" "$pin_release" || continue
        elif [ -n "$sdk_suffix" ] && { [ -z "$pin_suffix" ] || ! version_at_least "$sdk_suffix" "$pin_suffix"; }; then
          continue
        fi
        found="$sdk"
      done <<< "$sdks"
    fi
    [ -n "$found" ] || problem "no .NET SDK matches $pin (rollForward $roll) from $checkout/global.json" \
      "run triphammer update, which installs it on a machine of its own; elsewhere install the .NET SDK $pin or a later one global.json accepts (https://dotnet.microsoft.com/download) $units_path (~/.dotnet, with the drop-in of bin/README.md, Install, A project's toolchain)"
  else
    problem "$checkout/global.json pins no SDK version this doctor can read" "give sdk.version as major.minor.patch, with an optional prerelease suffix"
  fi
fi

# Node: within the checkout's package.json engines.node, whose comparators (>=, >, <=, <, = or a bare version,
# separated by blanks, each with one to three version parts) are checked; any other form (^, ~, ||) only needs Node
# to run. A partial version is a range as in semver: 24 is 24.x, so <=24 is <25.0.0 and >24 is >=25.0.0, and
# 24.1 is 24.1.x.
if tool node Node "install Node (https://nodejs.org) $units_path"; then
  node_version="$(node --version 2>/dev/null)" node_version="${node_version#v}"
  engines=""
  [ -z "$jq_ok" ] || engines="$(jq -r '.engines.node // empty' "$checkout/package.json" 2>/dev/null || true)"
  if [ -n "$engines" ] && [[ "$engines" =~ ^[[:space:]]*((>=|>|<=|<|=)?[0-9]+(\.[0-9]+){0,2}[[:space:]]*)+$ ]]; then
    fits=1
    for comparator in $engines; do
      bound="${comparator##*[<>=]}" op="${comparator%"$bound"}"
      # low: the bound's first version; high: the first version after a partial bound's range (none for a full one).
      case "$bound" in
        *.*.*) low="$bound" high="" ;;
        *.*) low="$bound.0" high="${bound%.*}.$((10#${bound#*.} + 1)).0" ;;
        *) low="$bound.0.0" high="$((10#$bound + 1)).0.0" ;;
      esac
      case "${op:-=}" in
        '>=') version_at_least "$node_version" "$low" || fits="" ;;
        '<') ! version_at_least "$node_version" "$low" || fits="" ;;
        '>') if [ -n "$high" ]; then version_at_least "$node_version" "$high" || fits=""
             else { version_at_least "$node_version" "$low" && [ "$node_version" != "$low" ]; } || fits=""; fi ;;
        '<=') if [ -n "$high" ]; then ! version_at_least "$node_version" "$high" || fits=""
              else version_at_least "$low" "$node_version" || fits=""; fi ;;
        '=') if [ -n "$high" ]; then { version_at_least "$node_version" "$low" && ! version_at_least "$node_version" "$high"; } || fits=""
             else [ "$node_version" = "$low" ] || fits=""; fi ;;
      esac
    done
    [ -n "$fits" ] || problem "Node $node_version is outside $engines, which $checkout/package.json requires" \
      "install a Node version within $engines (https://nodejs.org) $units_path"
  fi
fi

# Docker, for a project that declares "docker": true, or whose project file cannot be read: its sessions reach only
# the project's own rootless daemon, whose socket the machine file names (rootless_docker_host in config.sh), so that
# daemon answers this user, no other project's key names the same socket (rootless_docker_sockets), the rootful one at
# /var/run/docker.sock does not answer, the home of that daemon's user has the shape provision-project gives it
# (docker_home_problem), and Compose is v2 or later.
#
# docker_home_problem <daemon user>: reports one problem naming each part of the user's home that differs from
# docker_home_shape (config.sh), or from the unit root owns with mode 644 that default.target.wants links, so a container on the
# daemon could have planted a unit, a drop-in or a config its user manager, user bus or dockerd reads. A user the
# machine lacks, or a directory the doctor cannot list, counts as wrong, as the doctor cannot tell.
docker_home_problem() {
  local docker_user="$1" home line path name want names entries wrong=()
  home="$( { getent passwd "$docker_user" 2>/dev/null || true; } | cut -d: -f6)"
  if [ -z "$docker_user" ]; then
    wrong+=("the machine file names no user of it, so the doctor cannot tell")
  elif [ -z "$home" ]; then
    wrong+=("the machine has no user $docker_user, so the doctor cannot tell")
  else
    for line in "${docker_home_shape[@]}"; do
      read -ra entries <<< "$line"
      path="$home"
      [ "${entries[0]}" = . ] || path="$home/${entries[0]}"
      if [ -L "$path" ] || [ ! -d "$path" ]; then
        wrong+=("$path is not a directory")
        continue
      fi
      [ "$(stat -c '%u %a' -- "$path" 2>/dev/null)" = "0 755" ] || wrong+=("$path is not root's with mode 755")
      if ! names="$(find "$path" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null | LC_ALL=C sort)"; then
        wrong+=("$path cannot be listed, so the doctor cannot tell what it holds")
        continue
      fi
      while IFS= read -r name; do
        [ -n "$name" ] || continue
        for want in "${entries[@]:1}"; do [ "$name" != "$want" ] || continue 2; done
        wrong+=("$path/$name is not provision-project's")
      done <<< "$names"
    done
    path="$home/.config/systemd/user/docker.service"
    { [ -f "$path" ] && [ ! -L "$path" ] && [ "$(stat -c '%u %a' -- "$path" 2>/dev/null)" = "0 644" ]; } \
      || wrong+=("$path is not a file root owns with mode 644")
    [ "$(readlink -- "$home/.config/systemd/user/default.target.wants/docker.service" 2>/dev/null)" = "$path" ] \
      || wrong+=("$home/.config/systemd/user/default.target.wants/docker.service does not link to $path")
  fi
  [ ${#wrong[@]} -eq 0 ] && return 0
  problem "The home of this project's rootless Docker daemon's user is not as provision-project makes it ($(printf '%s; ' "${wrong[@]}" | sed 's/; $//')), so a container on that daemon may have changed what its user runs" \
    "look at each path named and remove what provision-project did not write, then run sudo triphammer update, which makes those directories root's (bin/README.md, The rootless Docker daemon)"
}
docker_project=1
if check_project doctor "$checkout" >/dev/null 2>&1 && [ "$(project_get "$checkout" docker)" != true ]; then
  docker_project=""
fi
docker_host="$(rootless_docker_host "$project")"
machine_file="$(machine_path)"
if [ -z "$docker_project" ]; then
  :
elif ! command -v docker >/dev/null 2>&1; then
  problem "Docker Engine (docker) is not installed on the units' PATH" "install Docker Engine with the Compose plugin (https://docs.docker.com/engine/install/) $units_path"
else
  if ! docker_key "$project" >/dev/null; then
    problem "The project name $project cannot name a rootless Docker daemon of its own, so no session of this project starts" \
      "rename the project in .triphammer/project.json to lower-case letters, digits and dashes, starting with a letter or a digit, then run sudo triphammer update (bin/README.md, The rootless Docker daemon)"
  elif [ -z "$docker_host" ]; then
    problem "The machine file $machine_file names no rootless Docker daemon of this project ($project), so no session of it starts" \
      "run sudo triphammer update, whose bin/provision-project sets up the daemon of each Docker project (bin/README.md, The rootless Docker daemon)"
  elif [ "$(rootless_docker_sockets | grep -cxF -- "${docker_host#unix://}")" -gt 1 ]; then
    problem "The machine file $machine_file names ${docker_host#unix://}, this project's rootless Docker daemon, for another daemon too, so another project's sessions reach this one's containers" \
      "run sudo triphammer update, which names each Docker project's own daemon (bin/README.md, The rootless Docker daemon)"
  elif ! DOCKER_HOST="$docker_host" docker info --format '{{.ServerVersion}}' >/dev/null 2>&1; then
    problem "The rootless Docker daemon of this project does not answer this user at ${docker_host#unix://} (docker info fails)" \
      "start the daemon user's docker.service, or run sudo triphammer update (bin/README.md, The rootless Docker daemon)"
  fi
  if docker -H unix:///var/run/docker.sock info --format '{{.ServerVersion}}' >/dev/null 2>&1; then
    problem "The rootful Docker daemon at /var/run/docker.sock answers this user, so a container it starts can write anywhere on the machine" \
      "take this user out of the docker group with sudo bin/provision, then restart its user manager or reboot so its processes drop the group"
  fi
  if docker_key "$project" >/dev/null && [ -n "$docker_host" ]; then
    docker_home_problem "$(machine_get "TRIPHAMMER_DOCKER_USER_$(docker_key "$project")")"
  fi
  compose="$(first_version "$(DOCKER_HOST="$docker_host" docker compose version --short 2>/dev/null || true)")"
  if [ -z "$compose" ] || ! version_at_least "$compose" 2; then
    problem "Docker Compose v2 is missing (docker compose version reports ${compose:-nothing})" \
      "install the docker-compose-plugin package (https://docs.docker.com/compose/install/linux/)"
  fi
fi

# Compose names: each other project with a config in ${XDG_CONFIG_HOME:-~/.config}/triphammer whose project file gives
# a composeProjectPattern, as this one's does, must match no Compose project name this one's matches, or either
# project's sweep may prune the other's containers while both run. Two patterns are taken as disjoint only when each
# starts with ^ and a literal prefix, has no | outside parentheses, and neither prefix starts the other; any other pair
# is reported. A project whose file is missing or malformed runs no sweep, so it is left out.
# compose_prefix <pattern>: prints the literal text every name the pattern matches starts with, or fails when the
# pattern does not tie every match to such a prefix.
compose_prefix() {
  local pattern="$1" head='^\^([A-Za-z0-9_-]*)(.?)' prefix i c depth=0 class="" closer rest
  [[ "$pattern" =~ $head ]] || return 1
  prefix="${BASH_REMATCH[1]}"
  # A quantifier after the run makes its last character optional.
  case "${BASH_REMATCH[2]}" in '*'|'?'|'{') prefix="${prefix%?}" ;; esac
  for ((i = 1; i < ${#pattern}; i++)); do
    c="${pattern:i:1}"
    if [ -n "$class" ]; then
      # Inside a bracket expression: [:name:], [.x.] and [=x=] end at their own closer, and the first ] (after an
      # optional ^) is a member.
      if [ "$c" = '[' ] && [[ "${pattern:i+1:1}" == [:.=] ]]; then
        closer="${pattern:i+1:1}]" rest="${pattern:i+2}"
        [[ "$rest" == *"$closer"* ]] || return 1
        rest="${rest%%"$closer"*}"
        i=$((i + 2 + ${#rest} + 1)) class=in
      elif [ "$c" = ']' ] && [ "$class" != start ]; then
        class=""
      elif [ "$c" = '^' ] && [ "$class" = start ] && [ "${pattern:i-1:1}" = '[' ]; then
        :
      else
        class=in
      fi
      continue
    fi
    case "$c" in
      '\') i=$((i + 1)) ;;
      '[') class=start ;;
      '(') depth=$((depth + 1)) ;;
      ')') depth=$((depth - 1)); [ "$depth" -ge 0 ] || return 1 ;;
      '|') [ "$depth" -gt 0 ] || return 1 ;;
    esac
  done
  [ -z "$class" ] && [ "$depth" -eq 0 ] || return 1
  printf '%s\n' "$prefix"
}
own_pattern=""
! check_project doctor "$checkout" >/dev/null 2>&1 || own_pattern="$(project_get "$checkout" composeProjectPattern)"
if [ -n "$own_pattern" ]; then
  # A pattern compose_prefix cannot tie to a prefix gets the empty one, which every name starts with, so it is reported.
  own_prefix="$(compose_prefix "$own_pattern" || true)"
  for other_file in "${XDG_CONFIG_HOME:-$HOME/.config}"/triphammer/*.conf; do
    [ -f "$other_file" ] || continue
    other="${other_file##*/}" other="${other%.conf}"
    [ "$other" != "$project" ] || continue
    other_checkout="$(sed -n 's/^CHECKOUT=//p' "$other_file" 2>/dev/null | head -n 1 || true)"
    [ -n "$other_checkout" ] && check_project doctor "$other_checkout" >/dev/null 2>&1 || continue
    other_pattern="$(project_get "$other_checkout" composeProjectPattern)"
    [ -n "$other_pattern" ] || continue
    other_prefix="$(compose_prefix "$other_pattern" || true)"
    [[ "$own_prefix" == "$other_prefix"* || "$other_prefix" == "$own_prefix"* ]] || continue
    problem "the composeProjectPattern of $project ($own_pattern) and that of $other ($other_pattern) can match the same Compose project name, so either project's database sweep may prune the other's containers" \
      "give each project's .triphammer/project.json a composeProjectPattern that starts with ^ and a literal prefix the other's does not start with, such as ^$project- and ^$other-"
  done
fi

# Playwright's browsers, for a project whose checkout pins Playwright as provision-project reads it (config.sh's
# playwright_manifests and playwright_filter): a Chromium in its browser cache. Which revision the project's Playwright
# wants is left to the web tests, which say so when it is missing. When the doctor cannot tell (no jq, no checkout, a
# file that is not JSON), it checks.
pins_playwright=1
if [ -n "$jq_ok" ] && manifests="$(git -C "$checkout" ls-files -- "$playwright_manifests" 2>/dev/null)"; then
  pins_playwright=""
  while IFS= read -r manifest; do
    [ -n "$manifest" ] || continue
    if ! pin="$(jq -r "$playwright_filter" "$checkout/$manifest" 2>/dev/null)" || [ -n "$pin" ]; then
      pins_playwright=1
      break
    fi
  done <<< "$manifests"
fi
browsers="${PLAYWRIGHT_BROWSERS_PATH:-$HOME/.cache/ms-playwright}"
if [ -n "$pins_playwright" ]; then
  # Each kind of Chromium Playwright installed, newest revision first, must print a blank page headless, as
  # Playwright starts it (no sandbox); one that cannot lacks its system libraries. A revision's directory without its
  # browser (an install cut short) holds no Chromium.
  installed=""
  for pattern in 'chromium-*/chrome-linux*/chrome' 'chromium_headless_shell-*/chrome-*/chrome-headless-shell'; do
    browser="$(compgen -G "$browsers/$pattern" | sort -V | tail -n 1 || true)"
    [ -n "$browser" ] || continue
    installed=1
    if ! timeout 60 "$browser" --headless --no-sandbox --disable-gpu --dump-dom about:blank 2>/dev/null | grep -q '<html'; then
      problem "Chromium does not start headless ($browser)" \
        "install its system libraries: as root, npx playwright install-deps chromium in the checkout's web app, or run triphammer update (bin/README.md, On a machine of its own)"
    fi
  done
  [ -n "$installed" ] || problem "Playwright's Chromium is not installed in $browsers" \
    "run triphammer update, which installs it on a machine of its own; elsewhere run npx playwright install chromium in the checkout's web app, as this user"
fi

if tool git git "install git $units_path"; then
  # The identity Triphammer's commits carry: git refuses to commit without one on a machine whose host name has no domain.
  # Only whether it is set is checked; neither value is printed. Only the global and system config count: a run's
  # clone (add_clone in ticket-runner) does not carry the checkout's local config.
  for key in user.name user.email; do
    [ -n "$(git -C / config --global --get "$key" 2>/dev/null || git -C / config --system --get "$key" 2>/dev/null || true)" ] \
      || problem "git has no $key for this user, so it may refuse to commit" \
        "set it with git config --global $key, as triphammer add does from APP_AUTHOR (bin/README.md, On a machine of its own)"
  done
fi
if tool python3 "Python 3" "install python3 $units_path"; then
  python_version="$(python3 --version 2>&1 || true)"
  [[ "$python_version" =~ ^Python\ 3\. ]] || problem "python3 is ${python_version:-unknown}, not Python 3" "install Python 3 as python3 $units_path"
fi
tool shellcheck ShellCheck "install shellcheck $units_path: sudo apt-get install shellcheck, or rerun provision" || true

# The App's credential files and, with qwen-audit on, the Qwen key file: by path, owner and mode only.
# credential <path> <the fix's subject>: reports a file that is missing, not a regular file, someone else's, or not
# mode 600.
credential() {
  local path="$1" owner mode
  if [ ! -e "$path" ]; then
    problem "$path is missing" "$2"
  elif [ ! -f "$path" ]; then
    problem "$path is not a regular file" "$2"
  else
    read -r owner mode < <(stat -L -c '%u %a' -- "$path")
    [ "$owner" = "$(id -u)" ] || problem "$path is not owned by $(id -un), the user Triphammer runs as" "chown $(id -un) $path"
    [ "$mode" = 600 ] || problem "$path has mode $mode, not 600" "chmod 600 $path"
  fi
}
app_dir="${GITHUB_APP_CONFIG_DIR:-$HOME/.config/github-app}"
for name in app-id owner agents.pem; do
  credential "$app_dir/$name" "the owner fills in the App's $name, mode 600 (bin/README.md, Install)"
done
if module_on qwen-audit; then
  if [ -n "${cfg[QWEN_KEY_FILE]:-}" ]; then
    credential "${cfg[QWEN_KEY_FILE]}" "put the Qwen server's API key in it, mode 600, owned by $(id -un)"
  else
    problem "$cfg_file turns qwen-audit on but sets no QWEN_KEY_FILE" "set QWEN_KEY_FILE to the file holding the key (bin/README.md, Modules)"
  fi
fi

# gh as the App: only an installation token may list the installation's repositories.
if tool gh "GitHub's gh" "install gh (https://cli.github.com) $units_path; through bin/gh it also needs the App's token (github-app-token)"; then
  # Its token is for the App's installation on the account that owns REPO, as ticket-runner's is (bin/github-app-token).
  # The calls without -R need it: the label list below names REPO with -R, from which bin/gh takes the account, and
  # `gh --version` above only shows that gh runs.
  app_owner="${cfg_repo%%/*}"
  if ! GITHUB_APP_OWNER="$app_owner" gh api installation/repositories --jq .total_count >/dev/null 2>&1; then
    problem "gh does not act as the agents' GitHub App on $app_owner, the owner of $cfg_repo (gh api installation/repositories fails)" \
      "install the App on $app_owner, link bin/gh and github-app-token into ~/.local/bin ahead of GitHub's gh and check the App's files (bin/README.md, Install)"
  else
    # The labels Triphammer reads and sets (bin/labels.sh), checked only once gh acts as the App, whose view counts.
    if ! missing="$(missing_labels "$cfg_repo" 2>/dev/null)"; then
      problem "gh label list fails for $cfg_repo, so the labels Triphammer uses were not checked" \
        "install the agents' GitHub App on $cfg_repo, then run the doctor again (bin/README.md, Labels)"
    else
      while IFS= read -r name; do
        [ -z "$name" ] || problem "$cfg_repo has no label $name, which Triphammer reads or sets" \
          "run triphammer add $cfg_repo again, with the options it was added with (bin/README.md, Labels)"
      done <<< "$missing"
    fi
    # Merged branches are deleted only with delete_branch_on_merge on: GitHub carries out an armed auto-merge later, and
    # merge-when-ready merges without --delete-branch. GitHub may leave the field out for a token without admin access,
    # which prints null; tojson keeps a string quoted, so only the boolean true passes and only false counts as off.
    delete_branch="$(GITHUB_APP_OWNER="$app_owner" gh api "repos/$cfg_repo" --jq '.delete_branch_on_merge | tojson' 2>/dev/null)" \
      || delete_branch=''
    case "$delete_branch" in
      true) ;;
      false)
        problem "$cfg_repo keeps head branches after their pull requests merge (delete_branch_on_merge is off)" \
          "the owner turns on Automatically delete head branches in the repository's settings, or runs gh api -X PATCH repos/$cfg_repo -F delete_branch_on_merge=true (bin/README.md, Install)" ;;
      *)
        problem "gh api repos/$cfg_repo gives no delete_branch_on_merge, so whether $cfg_repo deletes head branches after merge was not checked" \
          "the owner checks Automatically delete head branches in the repository's settings, or grants the agents' GitHub App read access to its administration (bin/README.md, Install)" ;;
    esac
  fi
fi

if tool claude "Claude Code" "install Claude Code (https://docs.anthropic.com/en/docs/claude-code) $units_path"; then
  if [ -n "$jq_ok" ] && ! claude auth status --json 2>/dev/null | jq -e '.loggedIn == true' >/dev/null 2>&1; then
    problem "Claude Code is not logged in" "run claude auth login as this user"
  fi
  # The plugins provision installs at user scope: Triphammer's, named by the marketplace file of Triphammer's checkout,
  # and humanizer@humanizer. A list that fails or is not a JSON array is a problem of its own, never a pass.
  if [ -n "$jq_ok" ]; then
    installer="run the installer again, which installs it (bin/README.md, On a machine of its own)"
    marketplace_file="$triphammer/.claude-plugin/marketplace.json"
    plugins=(humanizer@humanizer)
    if tri_plugin="$(jq -er '(.plugins[0].name | strings) + "@" + (.name | strings)' "$marketplace_file" 2>/dev/null)"; then
      plugins=("$tri_plugin" "${plugins[@]}")
    else
      problem "$marketplace_file is missing or names no plugin, so the Triphammer plugin was not checked" \
        "restore it from origin/main in Triphammer's checkout (git -C $triphammer checkout origin/main -- .claude-plugin/marketplace.json)"
    fi
    if ! installed="$(claude plugin list --json < /dev/null 2>/dev/null)" \
        || ! jq -e 'type == "array"' <<< "$installed" >/dev/null 2>&1; then
      problem "claude plugin list fails, so the plugins ${plugins[*]} were not checked" "$installer"
    else
      for id in "${plugins[@]}"; do
        jq -e --arg id "$id" 'any(.[]; .id == $id and .scope == "user")' <<< "$installed" >/dev/null 2>&1 \
          || problem "the Claude Code plugin $id is not installed at user scope for this user" "$installer"
      done
    fi
  fi
fi

if module_on codex && tool codex Codex "install the Codex CLI (npm install -g @openai/codex) $units_path"; then
  codex login status >/dev/null 2>&1 || problem "Codex is not logged in" "run codex login --device-auth as this user"
fi
# The sessions' write limit (bin/session-sandbox) is bwrap, as is Codex's sandbox, and it needs unprivileged user
# namespaces; Ubuntu restricts them with AppArmor. Without it the runner starts no session.
if tool bwrap bubblewrap "install bubblewrap (apt-get install bubblewrap) $units_path; the sessions' write limit needs it"; then
  bwrap --unshare-user --ro-bind / / true >/dev/null 2>&1 \
    || problem "bwrap cannot create a user namespace, so the sessions' write limit fails and no session starts" \
      "install the AppArmor profile /etc/apparmor.d/bwrap that allows it userns and load it (apparmor_parser -r), as triphammer update does (bin/README.md, The write limit)"
fi

if module_on qwen-audit; then
  if [ -z "${cfg[QWEN_BASE_URL]:-}" ]; then
    problem "$cfg_file turns qwen-audit on but sets no QWEN_BASE_URL" "set QWEN_BASE_URL to the model server (bin/README.md, Modules)"
  elif ! curl -sS -o /dev/null --max-time 10 "${cfg[QWEN_BASE_URL]}" >/dev/null 2>&1; then
    problem "QWEN_BASE_URL ${cfg[QWEN_BASE_URL]} does not answer" "start the model server or correct QWEN_BASE_URL in $cfg_file"
  fi
fi

units=("ticket-runner@$project.timer" "merge-when-ready@$project.timer")
! module_on demo || units+=("demo-gallery@$project.service")
if [ -z "$before_start" ]; then
  for unit in "${units[@]}"; do
    if ! state="$(systemctl --user is-enabled "$unit" 2>/dev/null)" || [ "$state" != enabled ]; then
      problem "the unit $unit is ${state:-not enabled}" \
        "link the template unit and run systemctl --user enable --now $unit (bin/README.md, Install)"
    fi
  done
fi

# The checkout: on main, clean, and at origin/main after a fetch (update-checkout's conditions, plus not ahead).
if ! git -C "$checkout" rev-parse --git-dir >/dev/null 2>&1; then
  problem "$checkout is not a git checkout" "clone the repository there or correct CHECKOUT in $cfg_file"
else
  branch="$(git -C "$checkout" symbolic-ref -q --short HEAD || true)"
  [ "$branch" = main ] || problem "$checkout is on ${branch:-a detached HEAD}, not main" "git -C $checkout switch main"
  [ -z "$(git -C "$checkout" status --porcelain 2>/dev/null)" ] \
    || problem "$checkout has uncommitted or untracked changes" "commit, move or remove them, so the runner can update it"
  if ! git -C "$checkout" fetch -q origin 2>/dev/null; then
    problem "git fetch origin fails in $checkout" "check the network and the App's git credential helper (bin/README.md, Install)"
  elif [ "$(git -C "$checkout" rev-parse -q --verify HEAD 2>/dev/null)" \
      != "$(git -C "$checkout" rev-parse -q --verify refs/remotes/origin/main 2>/dev/null)" ]; then
    problem "$checkout is not at origin/main" "git -C $checkout merge --ff-only origin/main, or reset it there when it is ahead"
  fi
fi

[ -z "$before_start" ] || echo "left out the units ${units[*]}, which triphammer start $project enables"
if [ "$problems" -gt 0 ]; then
  echo "$problems problem(s) found"
  exit 1
fi
echo "all good"

#!/usr/bin/env bash
# Runs a command under the sessions' write limit: bubblewrap (bwrap) mounts the whole file system read-only and makes
# writable only what a session needs, so neither the command nor anything it starts (Edit and Write, Bash, python and
# node scripts, subagents, git hooks) can write anywhere else. ticket-runner starts every session through it.
# See bin/README.md (The write limit).
#
#   session-sandbox <run directory> <command> [argument...]
#
# Writable inside, each only when it exists (the ones marked * are created first):
#   - the run directory, the run's clone of the main checkout (<checkout>/.worktrees/<run>), with its own .git inside
#     it, where its commits and refs go. The main checkout's .git stays read-only, the objects the clone reads through
#     its alternate (git clone --reference) included, so no config (core.fsmonitor, core.hooksPath), hook or object
#     the command writes reaches the git commands the next tick runs in the main checkout, outside the limit. A run
#     directory whose git directory or git common directory lies outside it, as a git worktree's does, runs nothing.
#     Triphammer's checkout's .git stays read-only too: land-pr fetches main into a temporary repository instead;
#   - /tmp, and $TMPDIR when it is set (the proposals file ticket-runner reads after the session is there);
#   - what Claude Code writes under the home directory: its runtime parts in ${CLAUDE_CONFIG_DIR:-~/.claude} (below),
#     its state in ~/.local/state/claude, and the caches commands fill: ~/.cache*, ~/.npm, ~/.nuget, NuGet's
#     ${XDG_DATA_HOME:-~/.local/share}/NuGet* (http-cache, v3-cache, plugins-cache), and $NUGET_PACKAGES*,
#     $NUGET_HTTP_CACHE_PATH* and $NUGET_PLUGINS_CACHE_PATH* when they are set;
#   - the plugin hooks' own files: text-lint.py's humanizer records ($TRIPHAMMER_HUMANIZER_STATE, else
#     ${XDG_STATE_HOME:-~/.local/state}/triphammer/humanizer*) and agent-guard.py's guard-overrides.log* in the shared
#     directory ($TRIPHAMMER_SHARED_DIR, else ${XDG_STATE_HOME:-~/.local/state}/triphammer), the file alone;
#   - what the upkeep audits write through local-audit --model codex: its run count in
#     ${XDG_STATE_HOME:-~/.local/state}/local-audit*, and Codex's runtime parts in ${CODEX_HOME:-~/.codex} (below);
#   - when docker is installed or ${DOCKER_CONFIG:-~/.docker} exists, its buildx* directory, where docker build and
#     docker compose build keep their builder state; the rest of the directory (config.json, cli-plugins, contexts)
#     configures docker, which the runner also runs outside the limit, and stays read-only, created or not;
#   - when dotnet is installed or ${DOTNET_CLI_HOME:-~}/.dotnet exists, that .dotnet* and .templateengine* beside it,
#     each as a tmpfs that the session's writes go to and that is gone when it ends: the CLI writes its per-user state
#     (first-use sentinels per SDK version, toolResolverCache, telemetry) into .dotnet, which also holds the SDK when
#     it is installed there and is on PATH, and dotnet new its template cache into .templateengine. In .dotnet the
#     entries that exist when the command starts stay there read-only (the dotnet host, sdk, shared, host, packs,
#     templates, the global tools in tools, the sentinels), but for the CLI's state directories toolResolverCache,
#     TelemetryStorageService and sdk-advertising, which start empty; .templateengine starts empty.
# Inside these directories, the parts that would change later sessions stay read-only: local-audit's codex-settings*,
# created empty; and NuGet's user configs in ~/.nuget that exist when the command starts, NuGet/NuGet.Config (in any
# case NuGet reads) and config, which can point later restores at other package sources.
#
# Claude Code's and Codex's directories, each when it exists, are a tmpfs inside, so what the command adds there is
# gone when it ends. What each holds when the command starts is mounted back onto it, read-only but for the runtime
# parts: in Claude Code's, projects*, sessions*, session-env*, shell-snapshots*, debug*, todos*, tasks*,
# file-history*, statsig*, plans*, paste-cache*, image-cache* and telemetry*, plugins/data* inside the read-only
# plugins, and its login, .credentials.json, which Claude Code rewrites in place when the rename onto it fails; in
# Codex's, sessions*, archived_sessions*, log*, shell_snapshots* and tmp*, auth.json and installation_id. A symlink
# there is made again as it is. Codex keeps its SQLite databases, and the journals SQLite creates beside them, in a
# tmpfs of their own inside, <Codex's directory>/sqlite, which CODEX_SQLITE_HOME names there. What the next session
# loads from these directories cannot be created either: each one missing gets an empty read-only stand-in, in Claude
# Code's CLAUDE.md, settings.json, settings.local.json, agents, commands, skills, hooks, rules, output-styles and
# plugins, and in Codex's config.toml, AGENTS.md, AGENTS.override.md, .env, hooks.json, agents, rules, prompts, skills,
# plugins and themes. Claude Code's auto memory for the run directory,
# projects/<the run directory with each character but a letter or digit made a dash>/memory*, is empty and read-only,
# and CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 inside keeps Claude Code from loading any project's memory.
#
# Hidden inside, each under an empty tmpfs mounted after everything above: the GitHub App's files,
# ${GITHUB_APP_CONFIG_DIR:-~/.config/github-app} (agents.pem, app-id, owner); its token cache,
# ${XDG_CACHE_HOME:-~/.cache}/github-app*, created first so the command cannot create it in the writable ~/.cache and
# read the tokens minted into it outside; and tokens* in the shared directory, every session's token directory. A
# session's GitHub token comes from the file $TRIPHAMMER_TOKEN_FILE names, which ticket-runner writes and rewrites
# outside the limit (bin/README.md, The session's GitHub token): its directory, which must lie directly in that tokens
# directory or the command does not run, is mounted back read-only, the directory rather than the file so a rewrite
# through a rename shows inside. Without TRIPHAMMER_TOKEN_FILE, as in ticket-runner's dry run and teardown, the command
# gets no token at all.
#
# The command also gets a /dev of its own, and a process namespace of its own with its /proc, so it cannot see or
# signal the machine's other processes; the processes outside still see it, so ticket-runner's brake stops it. The
# network is shared. bwrap ends the command when its parent dies (--die-with-parent), and every process left inside
# when the command exits.
#
# Not covered: a NuGet user config that does not exist when the command starts or is a symlink (the session may create
# or replace it in the writable ~/.nuget); a part of Claude Code's or Codex's directory that is a symlink into a
# writable path, which the command writes through; memory written under another project's directory in projects, which
# a Claude Code run outside the limit would load for that project; anything a writable path above lets a later session
# read (a cache, a transcript, local-audit's run count, or buildx's builder state, which picks the builder a later
# docker build uses); and the Docker socket, or any other socket of a service outside, which the command can still
# reach: a container started through Docker can write anywhere on the machine.
#
# Exit status: the command's, or 2 for bad arguments, or 1 when the run directory is no git checkout, its git directory
# lies outside it, TRIPHAMMER_TOKEN_FILE lies elsewhere than in a directory of the tokens directory, or bwrap fails.
set -euo pipefail

fail() { echo "session-sandbox: $1" >&2; exit "${2:-1}"; }
[ $# -ge 2 ] || fail "usage: session-sandbox <run directory> <command> [argument...]" 2
run_dir="$(readlink -f -- "$1")" && [ -d "$run_dir" ] || fail "$1 is not a directory" 2
shift
# The run directory's .git is the one git directory the command may write, so it must lie inside the run directory: a
# worktree's lies in its main checkout's .git, which its commits would need writable.
for kind in --absolute-git-dir --git-common-dir; do
  git_dir="$(git -C "$run_dir" rev-parse --path-format=absolute "$kind" 2>/dev/null)" \
    || fail "$run_dir is not in a git checkout"
  git_dir="$(readlink -f -- "$git_dir")"
  [[ "$git_dir" == "$run_dir"/* ]] \
    || fail "the git directory $git_dir of $run_dir lies outside it; a session runs only in a clone of its own"
done

state="${XDG_STATE_HOME:-$HOME/.local/state}"
claude="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
humanizer="${TRIPHAMMER_HUMANIZER_STATE:-$state/triphammer/humanizer}"
shared="${TRIPHAMMER_SHARED_DIR:-$state/triphammer}"
overrides="$shared/guard-overrides.log"
app_files="${GITHUB_APP_CONFIG_DIR:-$HOME/.config/github-app}"
token_cache="${XDG_CACHE_HOME:-$HOME/.cache}/github-app"
tokens="$shared/tokens"
# The session's token directory, which ticket-runner owns: a directory directly in the shared tokens directory.
token_dir=''
if [ -n "${TRIPHAMMER_TOKEN_FILE:-}" ]; then
  token_dir="$(dirname -- "$TRIPHAMMER_TOKEN_FILE")"
  { [ -d "$token_dir" ] && [ -d "$tokens" ] \
    && [ "$(dirname -- "$(readlink -f -- "$token_dir")")" = "$(readlink -f -- "$tokens")" ]; } \
    || fail "TRIPHAMMER_TOKEN_FILE ($TRIPHAMMER_TOKEN_FILE) must lie in a directory of $tokens"
fi
codex="${CODEX_HOME:-$HOME/.codex}"
nuget=("${XDG_DATA_HOME:-$HOME/.local/share}/NuGet" ${NUGET_PACKAGES:+"$NUGET_PACKAGES"}
  ${NUGET_HTTP_CACHE_PATH:+"$NUGET_HTTP_CACHE_PATH"} ${NUGET_PLUGINS_CACHE_PATH:+"$NUGET_PLUGINS_CACHE_PATH"})
# Claude Code's and Codex's runtime directories, created first and writable inside, and what the next session loads
# from their directories, covered when missing (a name ending in / is a directory).
claude_runtime=(projects sessions session-env shell-snapshots debug todos tasks file-history statsig plans paste-cache
  image-cache telemetry)
codex_runtime=(sessions archived_sessions log shell_snapshots tmp)
claude_loaded=(CLAUDE.md settings.json settings.local.json agents/ commands/ skills/ hooks/ rules/ output-styles/
  plugins/)
codex_loaded=(config.toml AGENTS.md AGENTS.override.md .env hooks.json agents/ rules/ prompts/ skills/ plugins/ themes/)
# Claude Code's auto memory for the run directory, kept empty and read-only.
memory="$claude/projects/${run_dir//[^a-zA-Z0-9]/-}/memory"
mkdir -p -- "$HOME/.cache" "${nuget[@]}"
[ ! -d "$claude/plugins" ] || mkdir -p -- "$claude/plugins/data"
[ ! -d "$claude" ] || (umask 077 && mkdir -p -- "${claude_runtime[@]/#/$claude/}" "$memory")
[ ! -d "$codex" ] || (umask 077 && mkdir -p -- "${codex_runtime[@]/#/$codex/}")
(umask 077 && mkdir -p -- "$humanizer" "$state/local-audit" "$token_cache" "$tokens" && : >> "$overrides" \
  && : >> "$state/local-audit/codex-settings")

args=(--unshare-user --unshare-pid --die-with-parent --ro-bind / / --dev /dev --proc /proc
  --setenv CLAUDE_CODE_DISABLE_AUTO_MEMORY 1)
# bind <option> <path...>: mounts each path that exists onto itself, symlinks resolved, after what came before, so a
# later mount wins inside an earlier one.
bind() {
  local option="$1" path
  shift
  for path; do
    [ -n "$path" ] && [ -e "$path" ] || continue
    path="$(readlink -f -- "$path")"
    args+=("$option" "$path" "$path")
  done
}
# private <dir> <writable name...>: an empty tmpfs over <dir>, so what the command adds there is gone when it ends,
# with each entry <dir> holds mounted back onto itself, writable when its name is listed and read-only otherwise. A
# symlink is made again as it is, and its target mounted writable when its name is listed.
private() {
  local dir path name listed writable
  dir="$(readlink -f -- "$1")"
  shift
  args+=(--tmpfs "$dir")
  for path in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
    [ -e "$path" ] || [ -L "$path" ] || continue
    name="${path##*/}" writable=''
    for listed; do [ "$name" != "$listed" ] || writable=1; done
    if [ -L "$path" ]; then
      args+=(--symlink "$(readlink -- "$path")" "$path")
      [ -z "$writable" ] || bind --bind "$path"
    elif [ -n "$writable" ]; then
      args+=(--bind "$path" "$path")
    else
      args+=(--ro-bind "$path" "$path")
    fi
  done
}
# cover <dir> <name...>: each name that <dir> lacks becomes an empty read-only file there, or an empty read-only
# directory for a name ending in /, so the command can neither create nor change it.
cover() {
  local dir name fd
  dir="$(readlink -f -- "$1")"
  shift
  for name; do
    [ ! -e "$dir/${name%/}" ] && [ ! -L "$dir/${name%/}" ] || continue
    if [[ "$name" == */ ]]; then
      args+=(--tmpfs "$dir/${name%/}" --remount-ro "$dir/${name%/}")
    else
      exec {fd}< /dev/null
      args+=(--ro-bind-data "$fd" "$dir/$name")
    fi
  done
}
bind --bind "$run_dir" /tmp "${TMPDIR:-}" \
  "$state/claude" "$HOME/.cache" "$HOME/.npm" "$HOME/.nuget" "${nuget[@]}" "$humanizer" "$overrides" \
  "$state/local-audit"
bind --ro-bind "$state/local-audit/codex-settings" \
  "$HOME/.nuget/NuGet"/[Nn]u[Gg]et.[Cc]onfig "$HOME/.nuget/config"
if [ -d "$claude" ]; then
  private "$claude" "${claude_runtime[@]}" .credentials.json
  cover "$claude" "${claude_loaded[@]}"
  bind --ro-bind "$memory"
  bind --bind "$claude/plugins/data"
fi
# Codex keeps its SQLite databases in its directory itself, beside the journals SQLite creates and deletes next to
# them, so inside they go to a tmpfs of their own and are gone when the command ends.
if [ -d "$codex" ]; then
  private "$codex" "${codex_runtime[@]}" auth.json installation_id
  cover "$codex" "${codex_loaded[@]}"
  args+=(--tmpfs "$(readlink -f -- "$codex")/sqlite" --setenv CODEX_SQLITE_HOME "$(readlink -f -- "$codex")/sqlite")
fi
docker_config="${DOCKER_CONFIG:-$HOME/.docker}"
if [ -d "$docker_config" ] || command -v docker >/dev/null 2>&1; then
  (umask 077 && mkdir -p -- "$docker_config/buildx")
  bind --bind "$docker_config/buildx"
fi
# .dotnet and .templateengine as tmpfs, what .dotnet holds read-only on top of it but for the CLI's state directories.
dotnet_home="${DOTNET_CLI_HOME:-$HOME}/.dotnet"
if [ -d "$dotnet_home" ] || command -v dotnet >/dev/null 2>&1; then
  templates="$(dirname "$dotnet_home")/.templateengine"
  mkdir -p -- "$dotnet_home" "$templates"
  dotnet_home="$(readlink -f -- "$dotnet_home")"
  args+=(--tmpfs "$(readlink -f -- "$templates")" --tmpfs "$dotnet_home")
  for path in "$dotnet_home"/* "$dotnet_home"/.[!.]* "$dotnet_home"/..?*; do
    [ -e "$path" ] || continue
    case "${path##*/}" in toolResolverCache | TelemetryStorageService | sdk-advertising) continue ;; esac
    args+=(--ro-bind "$path" "$path")
  done
fi
# Last, so they win over every mount above: an empty tmpfs over the App's files and its token cache, and over every
# session's token directory, then this session's own back, read-only. The directory, not the file, so the rename that
# rewrites the file outside shows inside.
for path in "$app_files" "$token_cache" "$tokens"; do
  if [ -e "$path" ]; then args+=(--tmpfs "$(readlink -f -- "$path")"); fi
done
[ -z "$token_dir" ] || bind --ro-bind "$token_dir"

exec bwrap "${args[@]}" -- "$@"

#!/usr/bin/env bash
# Runs a command under the sessions' write limit: bubblewrap (bwrap) mounts the whole file system read-only and makes
# writable only what a session needs, so neither the command nor anything it starts (Edit and Write, Bash, python and
# node scripts, subagents, git hooks) can write anywhere else. ticket-runner starts every session through it.
# See bin/README.md (The write limit).
#
#   session-sandbox <run directory> <command> [argument...]
#
# Writable inside, each only when it exists (the ones marked * are created first):
#   - the run directory, the run's clone of the main checkout (<checkout>/.worktrees/<run>), with its own .git inside
#     it, where its commits and refs go. The main checkout's .git stays read-only, the objects the clone reads through
#     its alternate (git clone --reference) included, so no config (core.fsmonitor, core.hooksPath), hook or object
#     the command writes reaches the git commands the next tick runs in the main checkout, outside the limit. A run
#     directory whose git directory or git common directory lies outside it, as a git worktree's does, runs nothing.
#     Triphammer's checkout's .git stays read-only too: land-pr fetches main into a temporary repository instead;
#   - /tmp, and $TMPDIR when it is set (the proposals file ticket-runner reads after the session is there);
#   - what Claude Code writes under the home directory: its runtime parts in ${CLAUDE_CONFIG_DIR:-~/.claude} (below)
#     and its state in ~/.local/state/claude;
#   - the project's cache directory, $TRIPHAMMER_CACHE_DIR, which must lie directly in caches in the shared directory
#     or the command does not run, and which ticket-runner gives each project its own of. Inside, these variables
#     point the commands' caches at directories in it, over any value they had outside: XDG_CACHE_HOME at xdg*
#     (Claude Code's, pip's and most other tools' caches), npm_config_cache at npm* (NPM_CONFIG_CACHE is unset),
#     NUGET_PACKAGES at nuget/packages*, NUGET_HTTP_CACHE_PATH at nuget/http-cache*, NUGET_PLUGINS_CACHE_PATH at
#     nuget/plugins-cache*, and BUILDX_CONFIG at buildx*, where docker build and docker compose build keep their
#     builder state. Without TRIPHAMMER_CACHE_DIR the directories are in an empty tmpfs that is gone when the command
#     ends. PLAYWRIGHT_BROWSERS_PATH names Playwright's browsers in the cache directory outside,
#     ${PLAYWRIGHT_BROWSERS_PATH:-${XDG_CACHE_HOME:-~/.cache}/ms-playwright}, when it exists, read-only. The home
#     directory's caches, ~/.cache, ~/.npm, ~/.nuget, NuGet's ${XDG_DATA_HOME:-~/.local/share}/NuGet and buildx's
#     ${DOCKER_CONFIG:-~/.docker}/buildx, stay read-only;
#   - the plugin hooks' own files: text-lint.py's humanizer records ($TRIPHAMMER_HUMANIZER_STATE, else
#     ${XDG_STATE_HOME:-~/.local/state}/triphammer/humanizer*) and agent-guard.py's guard-overrides.log* in the shared
#     directory ($TRIPHAMMER_SHARED_DIR, else ${XDG_STATE_HOME:-~/.local/state}/triphammer), the file alone;
#   - what the upkeep audits write through local-audit --model codex: its run count in
#     ${XDG_STATE_HOME:-~/.local/state}/local-audit*, and Codex's runtime parts in ${CODEX_HOME:-~/.codex} (below);
#   - when dotnet is installed or ${DOTNET_CLI_HOME:-~}/.dotnet exists, that .dotnet* and .templateengine* beside it,
#     each as a tmpfs that the session's writes go to and that is gone when it ends: the CLI writes its per-user state
#     (first-use sentinels per SDK version, toolResolverCache, telemetry) into .dotnet, which also holds the SDK when
#     it is installed there and is on PATH, and dotnet new its template cache into .templateengine. In .dotnet the
#     entries that exist when the command starts stay there read-only (the dotnet host, sdk, shared, host, packs,
#     templates, the global tools in tools, the sentinels), but for the CLI's state directories toolResolverCache,
#     TelemetryStorageService and sdk-advertising, which start empty; .templateengine starts empty. NuGet creates its
#     user config, ~/.nuget/NuGet/NuGet.Config, on first use and fails when it cannot, so when none exists (in any case
#     NuGet reads), ~/.nuget/NuGet* becomes a read-only tmpfs holding what it holds and a NuGet.Config of NuGet's
#     default content, the nuget.org source alone.
# Inside these directories, the parts that would change later sessions stay read-only: local-audit's codex-settings*,
# created empty.
#
# Claude Code's and Codex's directories, each when it exists, are a tmpfs inside, so what the command adds there is
# gone when it ends. What each holds when the command starts is mounted back onto it, read-only but for the runtime
# parts: in Claude Code's, projects*, sessions*, session-env*, shell-snapshots*, debug*, todos*, tasks*,
# file-history*, statsig*, plans*, paste-cache*, image-cache* and telemetry*, plugins/data* inside the read-only
# plugins, and its login, .credentials.json, which Claude Code rewrites in place when the rename onto it fails; in
# Codex's, sessions*, archived_sessions*, log*, shell_snapshots* and tmp*, auth.json and installation_id. A symlink
# there is made again as it is. Codex keeps its SQLite databases, and the journals SQLite creates beside them, in a
# tmpfs of their own inside, <Codex's directory>/sqlite, which CODEX_SQLITE_HOME names there. What the next session
# loads from these directories cannot be created either: each one missing gets an empty read-only stand-in, in Claude
# Code's CLAUDE.md, settings.json, settings.local.json, agents, commands, skills, hooks, rules, output-styles and
# plugins, and in Codex's config.toml, AGENTS.md, AGENTS.override.md, .env, hooks.json, agents, rules, prompts, skills,
# plugins and themes. Claude Code's auto memory for the run directory,
# projects/<the run directory with each character but a letter or digit made a dash>/memory*, is empty and read-only,
# and CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 inside keeps Claude Code from loading any project's memory.
#
# Hidden inside, each under an empty tmpfs mounted after everything above: the GitHub App's files,
# ${GITHUB_APP_CONFIG_DIR:-~/.config/github-app} (agents.pem, app-id, owner); its token cache,
# ${XDG_CACHE_HOME:-~/.cache}/github-app*, created first so the command cannot create it and read the tokens minted into
# it outside; tokens* in the shared directory, every session's token directory; and caches* in the shared directory,
# every project's cache directory, of which the project's own is mounted back writable after it. A
# session's GitHub token comes from the file $TRIPHAMMER_TOKEN_FILE names, which ticket-runner writes and rewrites
# outside the limit (bin/README.md, The session's GitHub token): its directory, which must lie directly in that tokens
# directory or the command does not run, is mounted back read-only, the directory rather than the file so a rewrite
# through a rename shows inside. Without TRIPHAMMER_TOKEN_FILE, as in ticket-runner's dry run and teardown, the command
# gets no token at all.
#
# The command also gets a /dev of its own, and a process namespace of its own with its /proc, so it cannot see or
# signal the machine's other processes; the processes outside still see it, so ticket-runner's brake stops it. The
# network is shared. The user's runtime directory, /run/user/<uid>, and $XDG_RUNTIME_DIR when it names another, are
# each an empty tmpfs of mode 0700 that the command may write, mounted before everything above, so neither the user
# manager, the session bus nor an agent's socket there is reachable; DBUS_SESSION_BUS_ADDRESS, SSH_AUTH_SOCK and
# GPG_AGENT_INFO are unset. The rootful Docker daemon's sockets, /var/run/docker.sock and /run/docker.sock, are hidden
# for every command, whether they exist when the command starts or not: the directory of each becomes an empty tmpfs
# holding each of its entries but the socket's name, mounted back as before, so neither a socket the daemon deletes and
# makes again nor one it makes later shows inside. With TRIPHAMMER_DOCKER=1, which ticket-runner sets for a project
# whose project file declares "docker": true, the command reaches the socket DOCKER_HOST (unix://<path>) names, which
# ticket-runner sets to the rootless daemon's (/var/lib/<user>-docker/docker.sock, from the machine file): it stays
# where it lies, read-only like the rest of the file system, so a daemon that makes it again is still reached, and one
# in a runtime directory is mounted back into its tmpfs. Without it that socket is hidden as the rootful ones are,
# unless it lies directly in /. For a path whose directory is missing, the first missing name on its way is left out
# of the directory that exists. What the machine adds to such a directory later, other than in an entry mounted back,
# does not show inside either.
# bwrap ends the command when its parent dies (--die-with-parent), and every process left inside when the command
# exits.
#
# Not covered: a NuGet user config, or a part of Claude Code's or Codex's directory, that is a symlink into a writable
# path, which the command writes through; memory written under another project's directory in projects, which a Claude
# Code run outside the limit would load for that project; what the command writes to its project's cache directory,
# which a later session of the same project reads and runs (a package in nuget/packages whose MSBuild targets a later
# build runs, a tarball in the npm cache, or buildx's builder state, which picks the builder a later docker build
# uses); anything else a writable path above lets a later session read (a transcript, local-audit's run count); with
# TRIPHAMMER_DOCKER=1, what the rootless daemon's user can do, as a container started through it, privileged or
# mounting / or not, acts as that user on the machine: it reads what is world-readable there and the run clones in
# <checkout>/.worktrees, which the command could read already, and writes what that user may (its own home, and
# whatever on the machine is world-writable), and the containers and volumes of every project that declares Docker,
# which share that daemon; a Docker daemon reached some other way than the sockets above (a socket
# elsewhere, a Docker context, TCP), a DOCKER_HOST socket whose directory is deleted and made again while the command
# runs, or one directly in /; and abstract Unix sockets, services listening on the machine's localhost, as the network
# is shared, and the system bus, which the command can reach too.
#
# Exit status: the command's, or 2 for bad arguments, or 1 when the run directory is no git checkout, its git directory
# lies outside it, TRIPHAMMER_TOKEN_FILE lies elsewhere than in a directory of the tokens directory,
# TRIPHAMMER_CACHE_DIR is no directory of the caches directory, or bwrap fails.
set -euo pipefail

fail() { echo "session-sandbox: $1" >&2; exit "${2:-1}"; }
[ $# -ge 2 ] || fail "usage: session-sandbox <run directory> <command> [argument...]" 2
run_dir="$(readlink -f -- "$1")" && [ -d "$run_dir" ] || fail "$1 is not a directory" 2
shift
# The run directory's .git is the one git directory the command may write, so it must lie inside the run directory: a
# worktree's lies in its main checkout's .git, which its commits would need writable.
for kind in --absolute-git-dir --git-common-dir; do
  git_dir="$(git -C "$run_dir" rev-parse --path-format=absolute "$kind" 2>/dev/null)" \
    || fail "$run_dir is not in a git checkout"
  git_dir="$(readlink -f -- "$git_dir")"
  [[ "$git_dir" == "$run_dir"/* ]] \
    || fail "the git directory $git_dir of $run_dir lies outside it; a session runs only in a clone of its own"
done

state="${XDG_STATE_HOME:-$HOME/.local/state}"
claude="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
humanizer="${TRIPHAMMER_HUMANIZER_STATE:-$state/triphammer/humanizer}"
shared="${TRIPHAMMER_SHARED_DIR:-$state/triphammer}"
overrides="$shared/guard-overrides.log"
app_files="${GITHUB_APP_CONFIG_DIR:-$HOME/.config/github-app}"
token_cache="${XDG_CACHE_HOME:-$HOME/.cache}/github-app"
tokens="$shared/tokens"
caches="$shared/caches"
# in_parent <directory> <parent>: whether both are directories and the first lies directly in the second.
in_parent() {
  [ -d "$1" ] && [ -d "$2" ] && [ "$(dirname -- "$(readlink -f -- "$1")")" = "$(readlink -f -- "$2")" ]
}
# The session's token directory and the project's cache directory, which ticket-runner owns: a directory directly in
# the shared tokens directory and one directly in the shared caches directory.
token_dir=''
if [ -n "${TRIPHAMMER_TOKEN_FILE:-}" ]; then
  token_dir="$(dirname -- "$TRIPHAMMER_TOKEN_FILE")"
  in_parent "$token_dir" "$tokens" \
    || fail "TRIPHAMMER_TOKEN_FILE ($TRIPHAMMER_TOKEN_FILE) must lie in a directory of $tokens"
fi
cache_dir=''
if [ -n "${TRIPHAMMER_CACHE_DIR:-}" ]; then
  in_parent "$TRIPHAMMER_CACHE_DIR" "$caches" \
    || fail "TRIPHAMMER_CACHE_DIR ($TRIPHAMMER_CACHE_DIR) must be a directory of $caches"
  cache_dir="$(readlink -f -- "$TRIPHAMMER_CACHE_DIR")"
fi
# Each variable that points a command's cache into the cache directory inside, and its directory there.
cache_vars=(XDG_CACHE_HOME npm_config_cache NUGET_PACKAGES NUGET_HTTP_CACHE_PATH NUGET_PLUGINS_CACHE_PATH BUILDX_CONFIG)
cache_subdirs=(xdg npm nuget/packages nuget/http-cache nuget/plugins-cache buildx)
codex="${CODEX_HOME:-$HOME/.codex}"
# Claude Code's and Codex's runtime directories, created first and writable inside, and what the next session loads
# from their directories, covered when missing (a name ending in / is a directory).
claude_runtime=(projects sessions session-env shell-snapshots debug todos tasks file-history statsig plans paste-cache
  image-cache telemetry)
codex_runtime=(sessions archived_sessions log shell_snapshots tmp)
claude_loaded=(CLAUDE.md settings.json settings.local.json agents/ commands/ skills/ hooks/ rules/ output-styles/
  plugins/)
codex_loaded=(config.toml AGENTS.md AGENTS.override.md .env hooks.json agents/ rules/ prompts/ skills/ plugins/ themes/)
# Claude Code's auto memory for the run directory, kept empty and read-only.
memory="$claude/projects/${run_dir//[^a-zA-Z0-9]/-}/memory"
[ -z "$cache_dir" ] || (umask 077 && mkdir -p -- "${cache_subdirs[@]/#/$cache_dir/}")
[ ! -d "$claude/plugins" ] || mkdir -p -- "$claude/plugins/data"
[ ! -d "$claude" ] || (umask 077 && mkdir -p -- "${claude_runtime[@]/#/$claude/}" "$memory")
[ ! -d "$codex" ] || (umask 077 && mkdir -p -- "${codex_runtime[@]/#/$codex/}")
(umask 077 && mkdir -p -- "$humanizer" "$state/local-audit" "$token_cache" "$tokens" "$caches" && : >> "$overrides" \
  && : >> "$state/local-audit/codex-settings")

args=(--unshare-user --unshare-pid --die-with-parent --ro-bind / / --dev /dev --proc /proc
  --setenv CLAUDE_CODE_DISABLE_AUTO_MEMORY 1)
# bind <option> <path...>: mounts each path that exists onto itself, symlinks resolved, after what came before, so a
# later mount wins inside an earlier one.
bind() {
  local option="$1" path
  shift
  for path; do
    [ -n "$path" ] && [ -e "$path" ] || continue
    path="$(readlink -f -- "$path")"
    args+=("$option" "$path" "$path")
  done
}
# private <dir> <writable name...>: an empty tmpfs over <dir>, so what the command adds there is gone when it ends,
# with each entry <dir> holds mounted back onto itself, writable when its name is listed and read-only otherwise. A
# symlink is made again as it is, and its target mounted writable when its name is listed.
private() {
  local dir path name listed writable
  dir="$(readlink -f -- "$1")"
  shift
  args+=(--tmpfs "$dir")
  for path in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
    [ -e "$path" ] || [ -L "$path" ] || continue
    name="${path##*/}" writable=''
    for listed; do [ "$name" != "$listed" ] || writable=1; done
    if [ -L "$path" ]; then
      args+=(--symlink "$(readlink -- "$path")" "$path")
      [ -z "$writable" ] || bind --bind "$path"
    elif [ -n "$writable" ]; then
      args+=(--bind "$path" "$path")
    else
      args+=(--ro-bind "$path" "$path")
    fi
  done
}
# cover <dir> <name...>: each name that <dir> lacks becomes an empty read-only file there, or an empty read-only
# directory for a name ending in /, so the command can neither create nor change it.
cover() {
  local dir name fd
  dir="$(readlink -f -- "$1")"
  shift
  for name; do
    [ ! -e "$dir/${name%/}" ] && [ ! -L "$dir/${name%/}" ] || continue
    if [[ "$name" == */ ]]; then
      args+=(--tmpfs "$dir/${name%/}" --remount-ro "$dir/${name%/}")
    else
      exec {fd}< /dev/null
      args+=(--ro-bind-data "$fd" "$dir/$name")
    fi
  done
}
# The user's runtime directories, each an empty tmpfs, with a rootless Docker socket there mounted back for a project
# that uses Docker.
docker=''
[ "${TRIPHAMMER_DOCKER:-}" != 1 ] || docker=1
runtime_dirs=()
for path in "/run/user/$UID" "${XDG_RUNTIME_DIR:-}"; do
  [ -n "$path" ] && [ -d "$path" ] || continue
  path="$(readlink -f -- "$path")"
  [ "${runtime_dirs[0]:-}" = "$path" ] || runtime_dirs+=("$path")
done
for path in "${runtime_dirs[@]}"; do args+=(--perms 0700 --tmpfs "$path"); done
args+=(--unsetenv DBUS_SESSION_BUS_ADDRESS --unsetenv SSH_AUTH_SOCK --unsetenv GPG_AGENT_INFO)
docker_host=''
[[ "${DOCKER_HOST:-}" != unix://* ]] || docker_host="${DOCKER_HOST#unix://}"
if [ -n "$docker" ] && [ -S "$docker_host" ]; then
  path="$(readlink -f -- "$docker_host")"
  for dir in "${runtime_dirs[@]}"; do [[ "$path" != "$dir"/* ]] || bind --bind "$path"; done
fi
bind --bind "$run_dir" /tmp "${TMPDIR:-}" \
  "$state/claude" "$humanizer" "$overrides" "$state/local-audit"
bind --ro-bind "$state/local-audit/codex-settings"
if [ -d "$claude" ]; then
  private "$claude" "${claude_runtime[@]}" .credentials.json
  cover "$claude" "${claude_loaded[@]}"
  bind --ro-bind "$memory"
  bind --bind "$claude/plugins/data"
fi
# Codex keeps its SQLite databases in its directory itself, beside the journals SQLite creates and deletes next to
# them, so inside they go to a tmpfs of their own and are gone when the command ends.
if [ -d "$codex" ]; then
  private "$codex" "${codex_runtime[@]}" auth.json installation_id
  cover "$codex" "${codex_loaded[@]}"
  sqlite="$(readlink -f -- "$codex")/sqlite"
  args+=(--tmpfs "$sqlite" --setenv CODEX_SQLITE_HOME "$sqlite")
fi
# .dotnet and .templateengine as tmpfs, what .dotnet holds read-only on top of it but for the CLI's state directories.
dotnet_home="${DOTNET_CLI_HOME:-$HOME}/.dotnet"
if [ -d "$dotnet_home" ] || command -v dotnet >/dev/null 2>&1; then
  templates="$(dirname "$dotnet_home")/.templateengine"
  mkdir -p -- "$dotnet_home" "$templates"
  dotnet_home="$(readlink -f -- "$dotnet_home")"
  args+=(--tmpfs "$(readlink -f -- "$templates")" --tmpfs "$dotnet_home")
  for path in "$dotnet_home"/* "$dotnet_home"/.[!.]* "$dotnet_home"/..?*; do
    [ -e "$path" ] || continue
    case "${path##*/}" in toolResolverCache | TelemetryStorageService | sdk-advertising) continue ;; esac
    args+=(--ro-bind "$path" "$path")
  done
  # NuGet creates its user config on first use and fails when it cannot, so a missing one gets a read-only stand-in
  # with NuGet's default content, in a read-only tmpfs over ~/.nuget/NuGet holding what the directory holds.
  nuget_user="$HOME/.nuget/NuGet"
  if ! compgen -G "$nuget_user/[Nn]u[Gg]et.[Cc]onfig" >/dev/null; then
    (umask 077 && mkdir -p -- "$nuget_user")
    private "$nuget_user"
    exec {fd}< <(printf '%s\n' '<?xml version="1.0" encoding="utf-8"?>' '<configuration>' '  <packageSources>' \
      '    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />' \
      '  </packageSources>' '</configuration>')
    nuget_user="$(readlink -f -- "$nuget_user")"
    args+=(--ro-bind-data "$fd" "$nuget_user/NuGet.Config" --remount-ro "$nuget_user")
  fi
fi
# The cache variables win over any value they had outside, and npm reads its setting in either case, so
# NPM_CONFIG_CACHE goes. Playwright's browsers, in the cache directory outside, are read there still.
browsers="${PLAYWRIGHT_BROWSERS_PATH:-${XDG_CACHE_HOME:-$HOME/.cache}/ms-playwright}"
[ ! -d "$browsers" ] || args+=(--setenv PLAYWRIGHT_BROWSERS_PATH "$(readlink -f -- "$browsers")")
[ -n "$cache_dir" ] || cache_dir="$(readlink -f -- "$caches")"
for i in "${!cache_vars[@]}"; do args+=(--setenv "${cache_vars[$i]}" "$cache_dir/${cache_subdirs[$i]}"); done
args+=(--unsetenv NPM_CONFIG_CACHE)
# Last, so they win over every mount above: an empty tmpfs over the App's files and its token cache, over every
# session's token directory and over every project's caches; then the project's cache directory back, writable, or
# without one the caches' directories in that empty tmpfs, gone when the command ends; and last this session's own
# token directory back, read-only (the directory, not the file, so the rename that rewrites the file outside shows
# inside).
for path in "$app_files" "$token_cache" "$tokens" "$caches"; do
  if [ -e "$path" ]; then args+=(--tmpfs "$(readlink -f -- "$path")"); fi
done
if [ -n "${TRIPHAMMER_CACHE_DIR:-}" ]; then
  bind --bind "$cache_dir"
else
  for name in "${cache_subdirs[@]}"; do args+=(--dir "$cache_dir/$name"); done
fi
[ -z "$token_dir" ] || bind --ro-bind "$token_dir"
# The rootful Docker daemon's sockets for every project, and for a project that does not use Docker the socket
# DOCKER_HOST names too: each socket's directory, whether the socket exists or not, as a mount over the socket itself
# would hold only until the daemon deletes it and makes it again. A path whose directory is missing hides the first
# missing name on its way in the directory that exists.
hide_sockets=(/var/run/docker.sock /run/docker.sock)
[ -n "$docker" ] || hide_sockets+=("$docker_host")
hide_dirs=() hide_names=()
for path in "${hide_sockets[@]}"; do
  [ -n "$path" ] || continue
  path="$(readlink -m -- "$path")"
  while [ "$path" != / ] && [ ! -d "$(dirname -- "$path")" ]; do path="$(dirname -- "$path")"; done
  [ "$path" != / ] && [ "$(dirname -- "$path")" != / ] || continue
  hide_dirs+=("$(dirname -- "$path")") hide_names+=("${path##*/}")
done
# Each directory once: an empty tmpfs over it holding each entry but the hidden names, mounted back as the last mount
# on the directory or one it lies in mounted it, and spliced right after that mount, so every later mount, inside
# the directory or not, still comes after it. A directory in a tmpfs (a runtime directory's) is hidden already.
for i in "${!hide_dirs[@]}"; do
  dir="${hide_dirs[$i]}"
  for ((j = 0; j < i; j++)); do [ "${hide_dirs[$j]}" != "$dir" ] || continue 2; done
  for ((at = ${#args[@]} - 1; at > 1; at--)); do
    [[ "${args[$at]}" == / || "$dir" == "${args[$at]}" || "$dir" == "${args[$at]}"/* ]] || continue
    option="${args[$at - 1]}"
    [ "$option" = --tmpfs ] || option="${args[$at - 2]}"
    case "$option" in --tmpfs | --bind | --ro-bind) break ;; esac
  done
  [ "$option" != --tmpfs ] || continue
  hidden=(--tmpfs "$dir")
  for path in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
    [ -e "$path" ] || [ -L "$path" ] || continue
    for ((j = i; j < ${#hide_dirs[@]}; j++)); do
      [ "${hide_dirs[$j]}" != "$dir" ] || [ "${hide_names[$j]}" != "${path##*/}" ] || continue 2
    done
    if [ -L "$path" ]; then hidden+=(--symlink "$(readlink -- "$path")" "$path"); else hidden+=("$option" "$path" "$path"); fi
  done
  [ "$option" = --bind ] || hidden+=(--remount-ro "$dir")
  args=("${args[@]:0:at + 1}" "${hidden[@]}" "${args[@]:at + 1}")
done

exec bwrap "${args[@]}" -- "$@"

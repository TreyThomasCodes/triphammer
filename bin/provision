#!/usr/bin/env bash
# Turns a fresh Ubuntu server into a machine of Triphammer's own, with no project yet: the owner runs it as root
# (install.sh does, through sudo), and again whenever they like, since a second run changes nothing that is already
# right. Projects come afterwards, each with `triphammer add` (bin/provision-project). See bin/README.md ("On a machine
# of its own") for the arguments, the machine's size and what the owner does afterwards.
#
#   provision --triphammer <owner/name> <checkout> [--user <name>] [--home <dir>] [--dry-run] [--no-owner-steps]
#   provision --owner-steps
#
# --triphammer is the repository that holds bin/ and the plugin, and where to clone it; the units, the ~/.local/bin
# links and the plugin install point at that checkout.
#
# It ends with what is left for the owner (owner_steps in bin/provision-lib.sh): the App's files, Claude Code's login,
# a project or the projects whose timers are off, and the optional status page, each only while it is not done, or one
# line saying the machine is ready. --no-owner-steps leaves that out, and --owner-steps prints only that, for the user
# and home the machine file names, and changes nothing; triphammer update uses both, so its report comes last.
#
# It installs, each only when it is not there already: git, jq, Python 3, curl, bubblewrap and the like from Ubuntu's
# archive;
# Docker Engine with Compose v2 and the GitHub CLI from their vendors' apt repositories, or Ubuntu's own packages when
# a vendor's repository does not serve this release (it says which); the service user (default `triphammer`) with
# lingering on, out of the docker group; a rootless Docker daemon under a user of its own, `<user>-docker`, with its
# packages, subordinate ids, lingering and user unit, and its socket where the service user alone can connect; the
# AppArmor profile /etc/apparmor.d/bwrap that lets bwrap, the sessions' write
# limit, create user namespaces; Triphammer's checkout, cloned as that user; Node from nodejs.org at the version the
# checkout's .node-version pins; Claude Code through its installer. It links the units and scripts as the README's
# Install section does, installs the Triphammer plugin and the humanizer plugin (from the blader/humanizer
# marketplace on GitHub) at user scope, points git's github.com credentials at
# github-app-token, writes the machine file /etc/triphammer.conf (bin/provision-lib.sh) and installs the triphammer
# command as /usr/local/bin/triphammer, a copy root owns, so the service user cannot change what the owner runs. It
# enables no timer.
#
# It never reads or writes a credential's value: it creates ~/.config/github-app (mode 700) and nothing in it, before
# any clone, and clones with github-app-token as git's credential helper: the checkout's once it is linked, until then
# a copy of the one beside this script. What it runs in the user's checkout (git, jq) runs as the user, never as root.
# Every argument is checked before anything changes; an unknown flag or a bad value exits 2 with the usage. A step
# that fails exits 1 naming it, and a later run carries on from there. --dry-run prints each change it would make
# (`would: ...`) and makes none.
#
# It leaves the rootful Docker Engine installed and running; only root and the docker group reach its socket.
#
# Tests (provision.test.mjs) run it with fakes of the package and account tools first on PATH (bin/provision-lib.sh).
# shellcheck disable=SC2016  # the sh -c and bash -c scripts expand their own arguments, not this shell's
set -euo pipefail
umask 022

prog=provision
here="$(dirname "$(readlink -f "$0")")"
usage() {
  cat >&2 <<'EOF'
usage: provision --triphammer <owner/name> <checkout> [--user <name>] [--home <dir>] [--dry-run] [--no-owner-steps]
       provision --owner-steps
EOF
}
# shellcheck source=bin/provision-lib.sh
source "$here/provision-lib.sh"

if [ "${1:-}" = --owner-steps ]; then
  [ $# -eq 1 ] || usage_error "--owner-steps takes no other argument"
  [ "$(id -u)" = 0 ] || fail "run it as root (sudo $0 --owner-steps), as it checks what only root may"
  dry_run=""
  read_machine
  owner_steps
  exit 0
fi

tri_repo="" tri_checkout="" user=triphammer home="" home_given="" dry_run="" owner_report=1
need_value() { [ "$1" -gt "$2" ] || usage_error "$3 needs $4"; }
while [ $# -gt 0 ]; do
  case "$1" in
    --triphammer)
      [ -z "$tri_repo" ] || usage_error "--triphammer is given twice"
      need_value $# 2 --triphammer "a repository and a checkout"
      tri_repo="$2" tri_checkout="$3"
      shift 3 ;;
    --user|--home)
      need_value $# 1 "$1" "a value"
      case "$1" in
        --user) user="$2" ;;
        --home) home="$2" home_given=1 ;;
      esac
      shift 2 ;;
    --dry-run) dry_run=1; shift ;;
    --no-owner-steps) owner_report=""; shift ;;
    --owner-steps) usage_error "--owner-steps takes no other argument" ;;
    -h|--help) usage; exit 0 ;;
    --project|--modules|--set|--app-author) usage_error "$1 belongs to triphammer add, which sets a project up once the machine is ready" ;;
    *) usage_error "unknown argument $1" ;;
  esac
done
[ -n "$tri_repo" ] || usage_error "--triphammer is missing"
[[ "$user" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || usage_error "--user must be a user name (lower-case letters, digits, _ and -), not $user"
docker_user="$user-docker"
[[ "$docker_user" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] \
  || usage_error "--user $user is too long: the rootless Docker daemon's user, $docker_user, must be a user name too"
[ -z "$home" ] || [[ "$home" == /* ]] || usage_error "--home must be an absolute path, not $home"
check_place --triphammer "$tri_repo" "$tri_checkout"
[ -n "$home" ] || home="/home/$user"

check_ubuntu

# A user that exists already keeps its home; --home must then name that one.
if user_exists; then
  existing="$(getent passwd "$user" | cut -d: -f6)"
  [ -z "$home_given" ] || [ "$existing" = "$home" ] || fail "the user $user exists with the home $existing, not $home"
  home="$existing"
fi
checkout_state "$tri_repo" "$tri_checkout" >/dev/null

apt_install ca-certificates curl git jq python3 openssl xz-utils shellcheck bubblewrap apparmor

# vendor_repo <name> <key URL> <keyring> <sources file> <sources> <package...>: adds a vendor's apt repository and
# installs its packages, or fails, leaving no sources file behind, so the caller falls back to Ubuntu's packages.
vendor_repo() {
  local name="$1" key_url="$2" keyring="$3" sources="$4" text="$5"
  shift 5
  if install -d -m 755 -- "$(dirname "$keyring")" "$(dirname "$sources")" \
      && curl -fsSL --max-time 120 -o "$keyring.provision" "$key_url" && chmod 644 "$keyring.provision" \
      && mv -f -- "$keyring.provision" "$keyring" && printf '%s' "$text" > "$sources" \
      && apt-get update -q && apt_fresh=1 \
      && DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends "$@"; then
    return 0
  fi
  echo "provision: $name's apt repository failed; removing it" >&2
  rm -f -- "$sources" "$keyring.provision"
  apt_fresh=""
  return 1
}
keyrings="$root/etc/apt/keyrings"
lists="$root/etc/apt/sources.list.d"

engine=docker-ce
if { installed docker-ce || installed docker.io; } && { installed docker-compose-plugin || installed docker-compose-v2; }; then
  installed docker-ce || engine=docker.io
  note "Docker Engine: installed already ($([ "$engine" = docker-ce ] && echo "Docker's repository" || echo "Ubuntu's archive"))"
elif curl -fsSIL --max-time 30 -o /dev/null "https://download.docker.com/linux/ubuntu/dists/$codename/Release" \
    && change "add Docker's apt repository for $codename and install Docker Engine with Compose v2 from it" \
      vendor_repo Docker https://download.docker.com/linux/ubuntu/gpg "$keyrings/docker.asc" "$lists/docker.sources" \
      "Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: $codename
Components: stable
Architectures: $arch
Signed-By: /etc/apt/keyrings/docker.asc
" docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin; then
  note "Docker Engine: from Docker's repository"
else
  note "Docker Engine: from Ubuntu's archive (docker.io, docker-compose-v2), as Docker's repository does not serve $codename"
  apt_install docker.io docker-compose-v2
  engine=docker.io
fi
# What the rootless daemon below needs: its scripts and RootlessKit (docker-ce-rootless-extras with Docker's packages;
# with Ubuntu's, docker.io ships the scripts under /usr/share/docker.io/contrib and RootlessKit is its own package),
# newuidmap and newgidmap (uidmap), slirp4netns for its network, the user's D-Bus that the unit requires, and setfacl
# (acl). Ubuntu's apparmor package holds the profile that lets /usr/bin/rootlesskit create user namespaces.
if [ "$engine" = docker-ce ]; then
  apt_install docker-ce-rootless-extras uidmap slirp4netns dbus-user-session acl
  rootless_sh=/usr/bin/dockerd-rootless.sh
else
  apt_install rootlesskit uidmap slirp4netns dbus-user-session acl
  rootless_sh=/usr/share/docker.io/contrib/dockerd-rootless.sh
fi

if installed gh; then
  note "GitHub CLI: installed already"
elif change "add the GitHub CLI's apt repository and install gh from it" \
    vendor_repo "The GitHub CLI" https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      "$keyrings/githubcli-archive-keyring.gpg" "$lists/github-cli.sources" "Types: deb
URIs: https://cli.github.com/packages
Suites: stable
Components: main
Architectures: $arch
Signed-By: /etc/apt/keyrings/githubcli-archive-keyring.gpg
" gh; then
  note "GitHub CLI: from the GitHub CLI's repository"
else
  note "GitHub CLI: from Ubuntu's archive (gh), as the GitHub CLI's repository failed"
  apt_install gh
fi

# in_group <user> <group>: succeeds when the user is a member of the group.
in_group() { id -nG "$1" 2>/dev/null | tr ' ' '\n' | grep -qxF -- "$2"; }
# linger <user>: lingering on for the user, so its user units run without a login.
linger() {
  if [ "$(loginctl show-user "$1" --property=Linger --value 2>/dev/null)" != yes ]; then
    change "turn lingering on for $1, so its user units run without a login" loginctl enable-linger "$1" \
      || fail "loginctl enable-linger failed"
  fi
}
# leave_group <user> <group>: takes the user out of the group when it is in it.
leave_group() {
  in_group "$1" "$2" || return 0
  change "remove $1 from the $2 group" gpasswd -d "$1" "$2" || fail "gpasswd could not remove $1 from $2"
}

# The service user: its own group, a login shell for the owner's sudo -iu, lingering on, and not in the docker group,
# whose socket is the rootful daemon's and so root's; its sessions reach the rootless daemon below instead. The
# processes it runs keep the group until its user manager restarts.
if ! user_exists; then
  change "create the user $user with the home $home" \
    useradd --create-home --home-dir "$home" --shell /bin/bash --user-group "$user" || fail "useradd failed"
fi
if in_group "$user" docker; then
  leave_group "$user" docker
  note "Docker: $user's running processes keep the docker group until its user manager restarts (sudo systemctl restart user@$(id -u "$user").service, which stops its units) or the machine reboots"
fi
linger "$user"

# The rootless Docker daemon, which the sessions of a project that declares "docker": true use, runs as a user of its
# own, <user>-docker, in a user namespace on that user's subordinate ids, so a container that mounts / or runs
# privileged acts as that user on the machine, and that user may read only the run clones of the Docker projects
# (docker_reads in bin/provision-lib.sh, which provision-project runs). It is in neither the service user's group nor
# the docker group. Its home holds the images and volumes (~/.local/share/docker).
#
# The socket: dockerd, started with --host, makes it at $docker_socket, in a directory of its own that the daemon's
# user owns with mode 700, outside /run, which RootlessKit replaces in the daemon's mount namespace with a copy. The
# directory's ACL lets the service user search it (--x) and nothing more, and the unit's ExecStartPost gives the
# service user rw- on the socket once the daemon is ready, whatever mode and group dockerd gave it; connecting to a
# socket takes write on it and search on its directory. No other user but root can reach it.
docker_home="$(dirname "$home")/$docker_user"
docker_dir="$root/var/lib/$docker_user"
docker_socket="$docker_dir/docker.sock"
if getent passwd "$docker_user" >/dev/null 2>&1; then
  docker_home="$(getent passwd "$docker_user" | cut -d: -f6)"
else
  change "create the user $docker_user with the home $docker_home, for the rootless Docker daemon" \
    useradd --create-home --home-dir "$docker_home" --shell /usr/sbin/nologin --user-group "$docker_user" \
    || fail "useradd failed"
fi
leave_group "$docker_user" "$user"
leave_group "$docker_user" docker
linger "$docker_user"

# Its subordinate uids and gids, 65536 of each, from the first id (at least 100000) past every range /etc/subuid, or
# /etc/subgid, holds; Ubuntu's useradd gives a new user them itself, which leaves nothing to do here.
for kind in uid gid; do
  grep -q "^$docker_user:" "$root/etc/sub$kind" 2>/dev/null && continue
  start="$({ cat -- "$root/etc/sub$kind" 2>/dev/null || true; } \
    | awk -F: 'BEGIN { end = 100000 } NF >= 3 && $2 + $3 > end { end = $2 + $3 } END { print end }')"
  change "give $docker_user the subordinate ${kind}s $start-$((start + 65535))" \
    usermod "--add-sub${kind}s" "$start-$((start + 65535))" "$docker_user" || fail "usermod could not add $docker_user's sub${kind}s"
done

# Its group bits are the ACL's mask, --x once the grant below is in, so a mode of 700 or 710 is as asked.
if [ ! -d "$docker_dir" ] || [ -L "$docker_dir" ] \
  || [[ "$(stat -c '%u %a' -- "$docker_dir")" != "$(id -u "$docker_user" 2>/dev/null) 7"[01]0 ]]; then
  change "create $docker_dir, mode 700, for $docker_user's socket" \
    sh -c 'mkdir -p -- "$1" && chmod 700 -- "$1" && chown -- "$2:" "$1"' sh "$docker_dir" "$docker_user" \
    || fail "could not create $docker_dir"
fi
acl "$docker_dir" "user:$user:--x"

# The daemon's user unit, as dockerd-rootless-setuptool.sh install writes it, with the socket's path and its grant.
before="$changes"
as_docker user_file "$docker_home/.config/systemd/user/docker.service" 644 "# Written by Triphammer's bin/provision: the rootless Docker daemon whose socket $user reaches (bin/README.md).
[Unit]
Description=Docker Application Container Engine (Rootless), for $user
Documentation=https://docs.docker.com/go/rootless/
Requires=dbus.socket

[Service]
Environment=PATH=/usr/bin:/sbin:/usr/sbin:/bin
ExecStart=$rootless_sh --host=unix://$docker_socket
ExecStartPost=/usr/bin/setfacl -m user:$user:rw- $docker_socket
ExecReload=/bin/kill -s HUP \$MAINPID
TimeoutSec=0
RestartSec=2
Restart=always
StartLimitBurst=3
StartLimitInterval=60s
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
Type=notify
NotifyAccess=all
KillMode=mixed

[Install]
WantedBy=default.target
"
if [ "$changes" -ne "$before" ]; then
  as_docker reload_units
  if as_docker user_enabled docker.service; then
    change "restart $docker_user's docker.service, whose unit changed" systemctl --machine="$docker_user@" --user restart docker.service \
      || fail "systemctl could not restart $docker_user's docker.service"
  fi
fi
if ! as_docker user_enabled docker.service; then
  change "enable and start $docker_user's docker.service, the rootless Docker daemon" \
    systemctl --machine="$docker_user@" --user enable --now docker.service \
    || fail "systemctl could not start $docker_user's docker.service; journalctl --machine=$docker_user@ --user -u docker.service says why"
fi

# bwrap's user namespaces, for the sessions' write limit (bin/session-sandbox) and Codex's sandbox: Ubuntu restricts
# them with AppArmor, which this profile lifts for /usr/bin/bwrap alone. A profile at that path that is not this
# script's is left alone. The marker keeps the words earlier runs wrote, so their profiles stay provision's.
profile="$root/etc/apparmor.d/bwrap"
marker="# Triphammer's provision: lets bwrap, Codex's sandbox, create user namespaces (bin/README.md)."
text="$marker
abi <abi/4.0>,
include <tunables/global>

profile bwrap /usr/bin/bwrap flags=(unconfined) {
  userns,

  include if exists <local/bwrap>
}
"
loaded=""
if [ -e "$profile" ] && ! grep -qxF -- "$marker" "$profile"; then
  note "AppArmor: leaving $profile alone, as it is not provision's"
elif ! same_root_file "$profile" 644 "$text"; then
  root_file "$profile" 644 "$text"
  change "load the AppArmor profile $profile" apparmor_parser -r "$profile" || fail "apparmor_parser could not load $profile"
  loaded=1
fi
userns() { as_user bwrap --unshare-user --ro-bind / / true >/dev/null 2>&1; }
if [ -z "$dry_run" ] && ! userns; then
  if [ -z "$loaded" ] && grep -qxF -- "$marker" "$profile" 2>/dev/null; then
    change "load the AppArmor profile $profile" apparmor_parser -r "$profile" || fail "apparmor_parser could not load $profile"
  fi
  userns || fail "bwrap still cannot create a user namespace as $user, which the sessions' write limit needs; check $profile and the kernel's apparmor_restrict_unprivileged_userns"
fi

# The App's directory, for the owner to fill in, and git's github.com credentials, which come from github-app-token
# alone; both before any clone, as a private repository clones only with the App's token.
app_dir="$home/.config/github-app"
if [ ! -d "$app_dir" ] || [ -L "$app_dir" ] || [ "$(stat -c %a -- "$app_dir")" != 700 ]; then
  change "create $app_dir, mode 700, for the App's files" as_user sh -c 'mkdir -p "$1" && chmod 700 "$1"' sh "$app_dir" \
    || fail "could not create $app_dir"
fi
helpers="$(as_user git config --global --get-all credential.https://github.com.helper 2>/dev/null || true)"
if [ "$helpers" != $'\n!github-app-token git-credential' ]; then
  change "point git's github.com credentials at github-app-token" as_user sh -c \
    "git config --global --replace-all credential.https://github.com.helper '' \
      && git config --global --add credential.https://github.com.helper '!github-app-token git-credential'" \
    || fail "could not set git's credential helper"
fi
# git tells the helper which repository it asks about, so the token is for the App's installation on that repository's
# account.
if [ "$(as_user git config --global --get credential.https://github.com.useHttpPath 2>/dev/null || true)" != true ]; then
  change "have git name the repository when it asks github-app-token for credentials" \
    as_user git config --global credential.https://github.com.useHttpPath true \
    || fail "could not set git's credential.https://github.com.useHttpPath"
fi

clone "$tri_repo" "$tri_checkout"
if cloned "$tri_repo" "$tri_checkout"; then
  for path in bin/config.sh bin/ticket-runner status/server.mjs .claude-plugin/marketplace.json; do
    as_user test -f "$tri_checkout/$path" || fail "$tri_checkout has no $path; --triphammer must be Triphammer's repository"
  done
fi

# The scripts on the units' PATH and the units, linked from Triphammer's checkout as the Install section does.
for script in ticket-runner merge-when-ready land-pr github-app-token gh demo-gallery; do
  user_link "$home/.local/bin/$script" "$tri_checkout/bin/$script"
done
user_link "$home/.local/bin/triphammer-status" "$tri_checkout/status/server.mjs"
reload=""
for unit in systemd/ticket-runner@.service systemd/ticket-runner@.timer systemd/merge-when-ready@.service \
    systemd/merge-when-ready@.timer systemd/demo-gallery@.service systemd/triphammer-status.service; do
  if [ "$(readlink -- "$home/.config/systemd/user/${unit##*/}" 2>/dev/null)" != "$tri_checkout/$unit" ]; then
    change "link the user unit ${unit##*/} from $tri_checkout" systemctl --machine="$user@" --user link "$tri_checkout/$unit" \
      || fail "systemctl could not link $tri_checkout/$unit for $user"
    reload=1
  fi
done
[ -z "$reload" ] || reload_units

# Node from nodejs.org into /usr/local, where the units' PATH finds it, at the version Triphammer's checkout pins. One
# Node serves every project; provision-project refuses a project that pins another.
install_node() {
  local version="$1" tarball="node-v$1-linux-$node_arch.tar.xz" scratch
  scratch="$(mktemp -d)"
  if curl -fsSL --max-time 600 -o "$scratch/$tarball" "https://nodejs.org/dist/v$version/$tarball" \
      && curl -fsSL --max-time 60 -o "$scratch/SHASUMS256.txt" "https://nodejs.org/dist/v$version/SHASUMS256.txt" \
      && (cd "$scratch" && grep -E "^[0-9a-f]{64}  $tarball\$" SHASUMS256.txt | sha256sum -c --status -) \
      && install -d -m 755 -- "$root/usr/local" \
      && tar -xJf "$scratch/$tarball" -C "$root/usr/local" --strip-components=1 --no-same-owner \
        --exclude=CHANGELOG.md --exclude=LICENSE --exclude=README.md; then
    rm -rf -- "$scratch"
    return 0
  fi
  rm -rf -- "$scratch"
  return 1
}
if cloned "$tri_repo" "$tri_checkout"; then
  as_user test -f "$tri_checkout/.node-version" || fail "$tri_checkout pins no Node version in .node-version"
  pin="$(as_user cat "$tri_checkout/.node-version" | tr -d '[:space:]')" pin="${pin#v}"
  [[ "$pin" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "$tri_checkout/.node-version pins no version major.minor.patch"
  if [ "$("$node_bin/node" --version 2>/dev/null)" = "v$pin" ]; then
    note "Node: v$pin installed already"
  else
    change "install Node v$pin from nodejs.org into $root/usr/local" install_node "$pin" \
      || fail "could not install Node v$pin (download, checksum or unpacking failed)"
  fi
else
  note "Node: the version comes from Triphammer's checkout, which is not cloned yet; a real run reads it after cloning"
fi

# Claude Code, through its installer, as the user: it lands in ~/.local/bin.
if ! as_user "$home/.local/bin/claude" --version >/dev/null 2>&1; then
  change "install Claude Code for $user with its installer" as_user bash -c \
    'set -e; d="$(mktemp -d)"; trap "rm -rf \"\$d\"" EXIT
     curl -fsSL --max-time 120 -o "$d/install.sh" https://claude.ai/install.sh
     bash "$d/install.sh"' || fail "the Claude Code installer failed"
fi

# user_plugin <marketplace> <source> <plugin>: adds the marketplace from its source (a directory, or a GitHub
# owner/repo) and installs <plugin>@<marketplace> at user scope for the user, each only when it is missing.
user_plugin() {
  local marketplace="$1" source="$2" id="$3@$1"
  if ! as_user_claude plugin marketplace list --json 2>/dev/null | jq -e --arg name "$marketplace" 'any(.[]; .name == $name)' >/dev/null; then
    change "add the plugin marketplace $marketplace from $source for $user" as_user_claude plugin marketplace add "$source" \
      || fail "claude could not add the marketplace $marketplace from $source"
  fi
  if ! as_user_claude plugin list --json 2>/dev/null \
      | jq -e --arg id "$id" 'any(.[]; .id == $id and .scope == "user")' >/dev/null; then
    change "install the plugin $id at user scope for $user" \
      as_user_claude plugin install "$id" --scope user || fail "claude could not install $id"
  fi
}
# The Triphammer plugin at user scope, from the marketplace file of Triphammer's checkout, and the humanizer plugin,
# whose skill the pull request hook requires, from the blader/humanizer marketplace on GitHub.
if cloned "$tri_repo" "$tri_checkout"; then
  marketplace="$(as_user jq -r .name "$tri_checkout/.claude-plugin/marketplace.json")" \
    || fail "$tri_checkout/.claude-plugin/marketplace.json is not JSON"
  user_plugin "$marketplace" "$tri_checkout" "$(as_user jq -r '.plugins[0].name' "$tri_checkout/.claude-plugin/marketplace.json")"
fi
user_plugin humanizer blader/humanizer humanizer

# The machine file, for provision-project and the triphammer command, and the command itself: a copy of this script's
# own bin/triphammer that root owns, never a link into the checkout the service user may write.
root_file "$machine_file" 644 "$(machine_text "$tri_repo" "$tri_checkout" "$user" "$home" "$docker_user" "$docker_socket")"$'\n'
root_file "$node_bin/triphammer" 755 "$(cat "$here/triphammer")"$'\n'

summary
[ -z "$owner_report" ] || owner_steps

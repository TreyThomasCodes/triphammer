#!/usr/bin/env bash
# Lands a pull request with main's copy of scripts/land-pr.sh (the merge-policy skill), as one command a session
# can run where piping fetched content into bash would be refused. Usage, from the checkout (a run's clone) whose HEAD
# is the pull request's pushed head:
#   land-pr <pr>
# The landing scripts come from the origin of Triphammer's checkout, the one this file lives in (through any symlink),
# which may be a repository other than the project's clone it runs in. It fetches that origin's main into a
# temporary bare repository of its own (mktemp -d, under $TMPDIR), never into Triphammer's checkout, whose .git a
# session cannot write, and removes it when it ends. It runs only when this file is byte for byte main's copy of
# bin/land-pr there, so a branch's copy of the wrapper never lands anything. It never runs a working tree's
# scripts/land-pr.sh, and tells land-pr.sh where that temporary repository is ($TRIPHAMMER_CHECKOUT), so main's
# classifier there is the one that runs.
# Exit code: land-pr.sh's (0 landed, 3 blocked, 1 anything else), or 1 when it refuses before running it.
set -euo pipefail

# One function, read whole before it runs, so an update of this file mid-run cannot change the run.
main() {
  [ "$#" -eq 1 ] || { echo "usage: land-pr <pull request number>" >&2; exit 1; }
  pr="$1"
  self="$(readlink -f "${BASH_SOURCE[0]}")"
  triphammer="$(git -C "$(dirname "$self")" rev-parse --show-toplevel)" \
    || { echo "land-pr: $self is not in a git checkout; nothing ran" >&2; exit 1; }
  url="$(git -C "$triphammer" remote get-url origin)" \
    || { echo "land-pr: $triphammer has no origin; nothing ran" >&2; exit 1; }

  main_git="$(mktemp -d)" || { echo "land-pr: cannot create a temporary directory; nothing ran" >&2; exit 1; }
  trap 'rm -rf "$main_git"' EXIT
  { git init -q --bare "$main_git" && git -C "$main_git" fetch -q "$url" +refs/heads/main:refs/remotes/origin/main; } \
    || { echo "land-pr: cannot fetch main from $url; nothing ran" >&2; exit 1; }
  if ! git -C "$main_git" show refs/remotes/origin/main:bin/land-pr 2>/dev/null | cmp -s - "$self"; then
    # The direct command for this directory: plain when its origin is Triphammer's, as in Triphammer's checkout or a
    # run's clone of it, with main fetched into a temporary repository when the project is another repository.
    direct="git fetch origin main && git show refs/remotes/origin/main:scripts/land-pr.sh | bash -s -- $pr"
    if [ "$url" != "$(git remote get-url origin 2>/dev/null || true)" ]; then
      direct="d=\"\$(mktemp -d)\" && git init -q --bare \"\$d\" && git -C \"\$d\" fetch -q $(printf %q "$url") +refs/heads/main:refs/remotes/origin/main && git -C \"\$d\" show refs/remotes/origin/main:scripts/land-pr.sh | TRIPHAMMER_CHECKOUT=\"\$d\" bash -s -- $pr; rm -rf \"\$d\""
    fi
    echo "land-pr: $self is not main's copy of bin/land-pr; nothing ran. Its checkout is behind origin/main; run main's script directly: $direct" >&2
    exit 1
  fi
  script="$(git -C "$main_git" show refs/remotes/origin/main:scripts/land-pr.sh)" \
    || { echo "land-pr: cannot read main's scripts/land-pr.sh; nothing ran" >&2; exit 1; }
  # land-pr.sh is fed on stdin, as `bash -s` expects, and closes stdin for everything it starts.
  TRIPHAMMER_CHECKOUT="$main_git" bash -s -- "$pr" <<< "$script"
}
main "$@"

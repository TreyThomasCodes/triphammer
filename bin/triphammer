#!/usr/bin/env bash
# The owner's command on a machine bin/provision set up, run as an ordinary user with sudo, or as root:
#
#   triphammer add <owner>/<repo> [<checkout>] [--modules <m,...>] [--set KEY=VALUE]... [--unset KEY]...
#                  [--app-author <login>] [--dry-run]
#   triphammer doctor [<project>]
#   triphammer plan [<project>]
#   triphammer start [<project>]
#   triphammer update [--dry-run]
#
# A machine serves one project. add, --dry-run or not, exits 1 naming the machine's project, before provision-project
# runs, when the service user's ~/.config/triphammer holds a config whose REPO is not the repository given, or one whose
# REPO cannot be read, or the directory is there but cannot be listed. Adding the machine's own project again works.
#
# add clones Triphammer's repository (from the machine file) into a temporary directory as the caller, runs that
# clone's bin/provision-project as root through sudo with the arguments given (which keeps the settings a project's
# config has unless they give others or --unset removes them), removes the clone, creates the labels
# Triphammer reads and sets that the repository lacks (ticket-runner --labels, as the service user, whose gh acts as the
# App; a failure is reported and undoes nothing), and then runs the doctor for the project with --before-start, which
# leaves out the units start enables. Running a fresh clone, from /, keeps root from running code in a checkout the
# service user can write. doctor and plan run ticket-runner --doctor or --plan for a project as the service user; start
# enables and starts the project's timers, and its gallery with the demo module. A <project> left out is the machine's
# only project.
#
# update brings what the runner cannot update by itself up to date: it clones Triphammer's repository as add does and
# runs that clone's bin/provision as root with the machine file's repository, checkout, user and home (which also
# replaces /usr/local/bin/triphammer), then the clone's provision-project for each project that has a config, with its
# REPO (read as data, never run) and no setting, so each keeps its settings. When systemd says one of the Triphammer
# units the projects use changed on disk (NeedDaemonReload), or cannot say, it reloads the service user's units; it
# enables, starts and stops no unit. It prints a line saying whether anything changed, runs the doctor for each project,
# and ends with what is left for the owner, the report provision ends with (provision --owner-steps, run as root from the
# clone; the run of provision before leaves it out with --no-owner-steps). --dry-run passes --dry-run to each script,
# prints `would: reload ...` for the reload, runs no doctor and changes nothing; it still ends with the report, which
# only reads. A provision that fails stops it; a provision-project that fails does not stop the other projects, and
# update then exits with its status. A doctor that finds a problem, or a report that fails, makes it exit 1. Nothing
# runs it on a timer.
#
# The service user, its home and Triphammer's repository and checkout come from the machine file /etc/triphammer.conf,
# which root owns; provision installs this script as /usr/local/bin/triphammer, a copy root owns too.
#
# sudo asks for the password once (sudo -v) before add or update changes anything, and it is not used when the caller
# is root (add, start, update) or the service user (doctor, plan, start). provision, provision-project and ticket-runner
# run in a session of their own with nothing on stdin, as install.sh runs provision: their output still reaches the
# terminal, but no command under them can be stopped for touching it. So Ctrl-C at the terminal reaches this script
# and the bash that runs the step (directly or through sudo), but not the step. As in install.sh, on an INT, TERM or
# HUP the script sends TERM to that bash (from a session of its own, since some sudo versions do not relay a signal
# sent from the process group the command runs in); on any of the three that bash sends TERM to the step's whole
# process group and waits for the step to end; and only then does the script end, by the signal it got. Exit status:
# the step's own (update's, above), 2 for a usage error, 1 when the machine file is missing or malformed.
#
# Tests (triphammer.test.mjs) use TRIPHAMMER_PROVISION_ROOT for where /etc lies and TRIPHAMMER_PROVISION_GIT_BASE for
# where repositories are cloned from, as provision does.
set -euo pipefail

root="${TRIPHAMMER_PROVISION_ROOT:-}"
git_base="${TRIPHAMMER_PROVISION_GIT_BASE:-https://github.com/}"
machine_file="$root/etc/triphammer.conf"

usage() {
  cat >&2 <<'EOF'
usage: triphammer add <owner>/<repo> [<checkout>] [--modules <m,...>] [--set KEY=VALUE]... [--unset KEY]...
                      [--app-author <login>] [--dry-run]
       triphammer doctor [<project>]
       triphammer plan [<project>]
       triphammer start [<project>]
       triphammer update [--dry-run]
EOF
}
usage_error() {
  printf 'triphammer: %s\n' "$1" >&2
  usage
  exit 2
}
fail() {
  printf 'triphammer: %s\n' "$1" >&2
  exit 1
}

# The machine file: Triphammer's repository and checkout, the service user and its home. This script reads it itself,
# not through config.sh's machine_get: provision installs it alone, as a copy root owns, and root must not source the
# service user's checkout.
read_machine() {
  local line key value
  tri_repo="" tri_checkout="" user="" home=""
  [ -r "$machine_file" ] || fail "$machine_file is missing; set the machine up first with install.sh"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    key="${line%%=*}" value="${line#*=}"
    case "$key" in
      TRIPHAMMER_REPO) tri_repo="$value" ;;
      TRIPHAMMER_CHECKOUT) tri_checkout="$value" ;;
      TRIPHAMMER_USER) user="$value" ;;
      TRIPHAMMER_HOME) home="$value" ;;
    esac
  done < "$machine_file"
  [[ "$tri_repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ && "$user" =~ ^[a-z_][a-z0-9_-]{0,31}$ && "$home" == /* ]] \
    || fail "$machine_file does not name Triphammer's repository, user and home; run install.sh again"
}

sudo=sudo
[ "$(id -u)" != 0 ] || sudo=""
# service_prefix: sets `service` to the command that runs the rest as the service user, which needs XDG_RUNTIME_DIR
# for systemctl --user.
service_prefix() {
  local uid
  uid="$(id -u "$user")" || fail "the user $user that $machine_file names does not exist"
  service=(env XDG_RUNTIME_DIR="/run/user/$uid")
  [ "$(id -un)" = "$user" ] || service=(sudo -iu "$user" "${service[@]}")
}
# as_service <command...>: runs a command as the service user.
as_service() {
  service_prefix
  "${service[@]}" "$@"
}

# A bash script that runs its arguments in a session of its own with nothing on stdin, waits for it, exits with its
# status, and on an INT, TERM or HUP sends TERM to the session's process group and goes on waiting. install.sh holds
# the same script. It passes through `sudo -i`, which hands the login shell every character escaped but `$`: so it is
# one line, and every expansion is braced, as `$\{` is literal to that shell.
# shellcheck disable=SC2016  # expanded by the bash that runs it
own_session='stop() { [ -z "${p}" ] || kill -TERM -- "-${p}" 2> /dev/null || kill -TERM "${p}"; }; p=; trap "t=1; stop" INT TERM HUP; (trap - INT QUIT; exec setsid "${@}") < /dev/null & p=${!}; [ -z "${t-}" ] || stop; while :; do wait "${p}" && exit 0 || s=${?}; kill -0 "${p}" 2> /dev/null || exit "${s}"; done'

# detached <prefix...> -- <command...>: runs the command, through the prefix (sudo, the service user's, or nothing), in
# a session of its own with nothing on stdin, and waits for it; returns its status. An INT, TERM or HUP meanwhile stops
# it, and once it has ended this script ends by that signal.
detached() {
  local prefix=() child="" caught="" woke status
  while [ "$1" != -- ]; do prefix+=("$1"); shift; done
  shift
  trap 'caught=INT woke=1; relay' INT
  trap 'caught=TERM woke=1; relay' TERM
  trap 'caught=HUP woke=1; relay' HUP
  (trap - INT QUIT; exec "${prefix[@]}" bash -c "$own_session" detached "$@") < /dev/null &
  child=$!
  [ -z "$caught" ] || relay
  # A wait a trap cut short waits again only while the child is still there: when the signal also reached the child (a
  # Ctrl-C to the process group) and it ended while the trap ran, bash can reap it there and lose its status, and a wait
  # for it then blocks until some other child ends (as_root's tee, which waits for this shell to close the FIFO).
  while :; do
    woke=""
    wait "$child" && status=0 || status=$?
    [ -n "$woke" ] && kill -0 "$child" 2> /dev/null || break
  done
  trap - INT TERM HUP
  [ -z "$caught" ] || kill -s "$caught" "$$"
  return "$status"
}
# relay: sends TERM to detached's child, if it has started.
relay() {
  [ -z "$child" ] || setsid -w kill -s TERM "$child" 2> /dev/null || true
}

# service_runner <project> <args...>: runs ticket-runner <args...> for a project as the service user, detached.
service_runner() {
  service_prefix
  detached "${service[@]}" -- env TRIPHAMMER_PROJECT="$1" "$home/.local/bin/ticket-runner" "${@:2}"
}

# config_names: sets `names` to the projects that have a config in the service user's ~/.config/triphammer. A directory
# that is missing has none; one that is there but cannot be listed stops the script.
config_names() {
  local configs name dir="$home/.config/triphammer"
  names=()
  if ! configs="$(as_service ls -1 "$dir" 2>/dev/null)"; then
    ! as_service test -e "$dir" || fail "could not list $dir as $user, so which projects this machine has is unknown"
    configs=""
  fi
  while IFS= read -r name; do
    [[ "$name" != *.conf ]] || names+=("${name%.conf}")
  done <<< "$configs"
}

# project <name or nothing>: sets `project` to the name given, or to the machine's only project.
project() {
  local names
  if [ -n "${1:-}" ]; then
    [[ "$1" =~ ^[A-Za-z0-9_-][A-Za-z0-9._-]*$ ]] || usage_error "$1 is not a project name"
    project="$1"
    return 0
  fi
  config_names
  case ${#names[@]} in
    1) project="${names[0]}" ;;
    0) fail "no project is set up yet; add one with triphammer add <owner>/<repo>" ;;
    *) printf 'triphammer: name the project, one of: %s\n' "${names[*]}" >&2; exit 2 ;;
  esac
}

# fresh_clone <what it does as root> <what the clone is for>: from /, asks sudo for the password once (unless the caller
# is root), and clones Triphammer's repository into $work/triphammer, a temporary directory the EXIT trap removes.
fresh_clone() {
  cd /  # nothing root runs starts in the caller's directory
  if [ -n "$sudo" ]; then
    echo "$1; sudo asks for your password once."
    sudo -v
  fi
  work="$(mktemp -d)"  # global: the EXIT trap runs after the caller has returned
  trap 'rm -rf -- "$work"' EXIT
  git clone -q --depth 1 -- "$git_base$tri_repo.git" "$work/triphammer" \
    || fail "could not clone $tri_repo, whose $2"
  mkfifo "$work/pipe"
}
# as_root <script> <args...>: runs the clone's bin/<script> as root, detached, its output both on the terminal and in
# $work/output; returns its status. Through a FIFO rather than a pipeline, so that detached runs in this shell and
# catches its signals.
as_root() {
  local status=0 tee_pid
  tee "$work/output" < "$work/pipe" &
  tee_pid=$!
  detached $sudo -- bash "$work/triphammer/bin/$1" "${@:2}" > "$work/pipe" || status=$?
  wait "$tee_pid"
  return "$status"
}

# one_project <owner/name>: stops the script when the service user has a config for a project of another repository
# than the one given (its REPO, compared as provision-project compares it, ignoring case), or one whose REPO cannot be
# read: a machine serves one project.
one_project() {
  local names name repo others=()
  config_names
  for name in "${names[@]}"; do
    repo="$(as_service sed -n 's/^REPO=//p' "$home/.config/triphammer/$name.conf")" || repo=""
    [ "${repo,,}" = "${1,,}" ] || others+=("$name")
  done
  [ ${#others[@]} -eq 0 ] || fail "this machine serves ${others[*]} already, and one machine serves one project; set $1 up on a machine of its own (bin/README.md, Several projects)"
}

add() {
  local arg dry_run="" status=0 name
  for arg; do [ "$arg" != --dry-run ] || dry_run=1; done
  if [ $# -eq 0 ] || [[ "$1" == -* ]]; then usage_error "add needs a repository, owner/name"; fi
  read_machine
  fresh_clone "triphammer add installs the project's toolchains as root and writes its files as $user" \
    "bin/provision-project sets the project up"
  one_project "$1"
  as_root provision-project "$@" || status=$?
  [ "$status" -eq 0 ] || exit "$status"
  name="$(sed -n 's/^project: //p' "$work/output" | tail -n 1)"
  [ -z "$dry_run" ] || return 0
  [[ "$name" =~ ^[A-Za-z0-9_-][A-Za-z0-9._-]*$ ]] || fail "provision-project named no project"
  echo
  echo "The labels Triphammer uses:"
  service_runner "$name" --labels \
    || echo "triphammer: not every label Triphammer uses could be created; the doctor lists the missing ones" >&2
  echo
  echo "The doctor's check of $name:"
  service_runner "$name" --doctor --before-start || true
  echo
  echo "Start it, once the doctor finds nothing missing: triphammer start $name"
}

runner() {
  local flag="$1"
  shift
  [ $# -le 1 ] || usage_error "${flag#--} takes at most one project"
  read_machine
  project "${1:-}"
  service_runner "$project" "$flag"
}

start() {
  [ $# -le 1 ] || usage_error "start takes at most one project"
  read_machine
  project "${1:-}"
  local config="$home/.config/triphammer/$project.conf" modules units
  as_service test -f "$config" || fail "$project has no config ($config); add it with triphammer add <owner>/<repo>"
  modules="$(as_service sed -n 's/^MODULES=//p' "$config")"
  units=("ticket-runner@$project.timer" "merge-when-ready@$project.timer")
  [[ ",$modules," != *,demo,* ]] || units+=("demo-gallery@$project.service")
  user_systemctl enable --now "${units[@]}"
  echo "Started ${units[*]}."
}

# user_systemctl <args...>: systemctl --user for the service user, through its own user manager.
user_systemctl() {
  if [ "$(id -un)" = "$user" ]; then
    as_service systemctl --user "$@"
  else
    $sudo systemctl --machine="$user@" --user "$@"
  fi
}

update() {
  local arg dry=() names repos=() name repo i status=0 changed="" units shown
  for arg; do
    case "$arg" in
      --dry-run) dry=(--dry-run) ;;
      *) usage_error "update takes no argument but --dry-run, not $arg" ;;
    esac
  done
  read_machine
  [[ "$tri_checkout" == /* ]] || fail "$machine_file names no TRIPHAMMER_CHECKOUT; run install.sh again"
  fresh_clone "triphammer update installs the machine's and each project's toolchains as root" \
    "bin/provision updates the machine"
  # Every project's repository, read from its config as data before anything changes.
  config_names
  for name in "${names[@]}"; do
    repo="$(as_service sed -n 's/^REPO=//p' "$home/.config/triphammer/$name.conf")"
    [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] \
      || fail "$home/.config/triphammer/$name.conf names no repository as one REPO=<owner>/<name> line"
    repos+=("$repo")
  done

  echo "The machine:"
  as_root provision --triphammer "$tri_repo" "$tri_checkout" --user "$user" --home "$home" --no-owner-steps "${dry[@]}" \
    || exit $?
  grep -qx 'Nothing to change: the machine is as asked.' "$work/output" || changed=1
  for i in "${!names[@]}"; do
    echo
    echo "The project ${names[i]}:"
    as_root provision-project "${repos[i]}" "${dry[@]}" || {
      status=$?
      printf 'triphammer: provision-project %s failed (exit %s)\n' "${repos[i]}" "$status" >&2
    }
    grep -qx 'Nothing to change: the machine is as asked.' "$work/output" || changed=1
  done

  # The units are links into Triphammer's checkout, which each tick updates without reloading them: reload when systemd
  # says a unit file changed under it, or when it cannot say.
  echo
  units=(triphammer-status.service)
  for name in "${names[@]}"; do
    units+=("ticket-runner@$name.service" "ticket-runner@$name.timer" "merge-when-ready@$name.service"
      "merge-when-ready@$name.timer" "demo-gallery@$name.service")
  done
  if ! shown="$(user_systemctl show --property=NeedDaemonReload -- "${units[@]}")" \
      || grep -qx 'NeedDaemonReload=yes' <<< "$shown"; then
    changed=1
    if [ ${#dry[@]} -gt 0 ]; then
      echo "would: reload $user's systemd units"
    else
      echo "+ reload $user's systemd units"
      user_systemctl daemon-reload || { echo "triphammer: systemctl could not reload $user's units" >&2; status=1; }
    fi
  fi
  if [ "$status" -ne 0 ]; then
    echo "triphammer: not every step of the update succeeded; the errors above say which" >&2
  elif [ -z "$changed" ]; then
    echo "Nothing to change: the machine and every project are as asked."
  elif [ ${#dry[@]} -gt 0 ]; then
    echo "The changes above would be made; nothing was changed."
  else
    echo "The changes above were made."
  fi
  if [ ${#dry[@]} -eq 0 ]; then
    for name in "${names[@]}"; do
      echo
      echo "The doctor's check of $name:"
      service_runner "$name" --doctor || [ "$status" -ne 0 ] || status=1  # a failed step's status wins over the doctor's
    done
  fi
  # What is left for the owner, from provision's own report; it only reads, so a dry run prints it too.
  as_root provision --owner-steps || {
    printf 'triphammer: provision could not list what is left for the owner (exit %s)\n' "$?" >&2
    [ "$status" -ne 0 ] || status=1
  }
  exit "$status"
}

case "${1:-}" in
  add) shift; add "$@" ;;
  doctor) shift; runner --doctor "$@" ;;
  plan) shift; runner --plan "$@" ;;
  start) shift; start "$@" ;;
  update) shift; update "$@" ;;
  ''|-h|--help|help) usage; [ -n "${1:-}" ] || exit 2 ;;
  *) usage_error "unknown command $1" ;;
esac

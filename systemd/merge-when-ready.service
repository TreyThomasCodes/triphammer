# Runs merge-when-ready once. Started by merge-when-ready.timer; install both (see README.md):
#   systemctl --user link <main checkout>/systemd/merge-when-ready.service
# It runs ~/.local/bin/merge-when-ready, the symlink to the main checkout's copy the install creates, so the unit names
# no checkout; the script reads the Triphammer config (README.md, "Configuration").
[Unit]
Description=Merge armed, ready pull requests for the agents' GitHub App

[Service]
Type=oneshot
UMask=0077
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/merge-when-ready

# Starts ticket-runner@<project>.service. Install from the main checkout (see README.md):
#   systemctl --user link <main checkout>/systemd/ticket-runner@.timer
#   systemctl --user enable --now ticket-runner@<project>.timer
[Unit]
Description=Start the ticket runner of %i every ten minutes

[Timer]
OnBootSec=5min
OnCalendar=*:0/10

[Install]
WantedBy=timers.target

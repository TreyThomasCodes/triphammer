# Runs one ticket-runner tick. Started by ticket-runner.timer; install both (see README.md):
#   systemctl --user link <main checkout>/systemd/ticket-runner.service
# It runs ~/.local/bin/ticket-runner, the symlink to the main checkout's copy the install creates, so the unit names no
# checkout; the script reads the Triphammer config (README.md, "Configuration"). A project's own toolchain comes onto PATH
# through a drop-in (README.md, Install, "A project's toolchain").
[Unit]
Description=Run the next ticket in a fresh unattended Claude Code session

[Service]
Type=oneshot
UMask=0077
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/ticket-runner
TimeoutStartSec=7h

# Starts merge-when-ready.service. Install from the main checkout (see README.md):
#   systemctl --user link <main checkout>/systemd/merge-when-ready.timer
#   systemctl --user enable --now merge-when-ready.timer
[Unit]
Description=Run merge-when-ready every two minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=2min

[Install]
WantedBy=timers.target
